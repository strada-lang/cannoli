package Cannoli::WebSocket;


# cannoli/src/websocket.strada - Basic WebSocket support
#
# Provides handshake helpers and simple frame send/receive utilities.

# WebSocket GUID for Sec-WebSocket-Accept
func Cannoli_WebSocket_guid() str {
    return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
}

# Check if request looks like a WebSocket upgrade
func Cannoli_WebSocket_is_upgrade_request(hash %req) int {
    my str $method = $req{"method"};
    if ($method ne "GET") {
        return 0;
    }

    my str $upgrade = lc(Cannoli::Request::get_header(%req, "Upgrade"));
    my str $connection = lc(Cannoli::Request::get_header(%req, "Connection"));

    if ($upgrade ne "websocket") {
        return 0;
    }
    if (index($connection, "upgrade") < 0) {
        return 0;
    }

    return 1;
}

# Byte helpers in C: unmasking and UTF-8 validation are per-byte loops that
# are quadratic or very slow when written with string concatenation.
__C__ {
static StradaValue *cannoli_ws_unmask(StradaValue *data, int64_t m0, int64_t m1, int64_t m2, int64_t m3) {
    size_t n = 0;
    const char *p = "";
    if (data && !STRADA_IS_TAGGED_INT(data) && data->type == STRADA_STR && data->value.pv) {
        p = data->value.pv;
        n = STRADA_STR_BYTELEN(data);
        if (n == 0 && p[0] != '\0') n = strlen(p);
    }
    if (n == 0) return strada_new_str("");
    unsigned char mask[4] = {(unsigned char)m0, (unsigned char)m1, (unsigned char)m2, (unsigned char)m3};
    char *out = malloc(n);
    if (!out) return strada_new_str("");
    for (size_t i = 0; i < n; i++) out[i] = (char)((unsigned char)p[i] ^ mask[i & 3]);
    StradaValue *r = strada_new_str_len(out, n);
    free(out);
    return r;
}

/* RFC 3629 UTF-8 (no overlongs, surrogates or > U+10FFFF) */
static int cannoli_ws_utf8_ok(const unsigned char *s, size_t n) {
    size_t i = 0;
    while (i < n) {
        unsigned char c = s[i];
        if (c < 0x80) { i++; continue; }
        size_t len; unsigned int cp;
        if (c >= 0xC2 && c <= 0xDF) { len = 2; cp = c & 0x1F; }
        else if (c >= 0xE0 && c <= 0xEF) { len = 3; cp = c & 0x0F; }
        else if (c >= 0xF0 && c <= 0xF4) { len = 4; cp = c & 0x07; }
        else return 0;
        if (i + len > n) return 0;
        for (size_t k = 1; k < len; k++) {
            if ((s[i + k] & 0xC0) != 0x80) return 0;
            cp = (cp << 6) | (s[i + k] & 0x3F);
        }
        if ((len == 3 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) || (len == 4 && (cp < 0x10000 || cp > 0x10FFFF))) return 0;
        i += len;
    }
    return 1;
}
}

func Cannoli_WebSocket_unmask(str $data, int $m0, int $m1, int $m2, int $m3) str {
    my str $out = "";
    __C__ {
        out = cannoli_ws_unmask(data, strada_to_int(m0), strada_to_int(m1), strada_to_int(m2), strada_to_int(m3));
    }
    return $out;
}

func Cannoli_WebSocket_valid_utf8(str $data) int {
    my scalar $ok = 0;
    __C__ {
        size_t n = 0;
        const char *p = "";
        if (data && !STRADA_IS_TAGGED_INT(data) && data->type == STRADA_STR && data->value.pv) {
            p = data->value.pv;
            n = STRADA_STR_BYTELEN(data);
            if (n == 0 && p[0] != '\0') n = strlen(p);
        }
        ok = strada_new_int(cannoli_ws_utf8_ok((const unsigned char *)p, n));
    }
    return $ok;
}

# Origin check for the upgrade request. $allowed: "" = same origin as the
# Host header (requests without Origin -- non-browser clients -- pass),
# "*" = any, else a comma-separated list of exact origins.
func Cannoli_WebSocket_origin_allowed(str $origin, str $host, str $allowed) int {
    if (length($origin) == 0 || $allowed eq "*") { return 1; }
    if (length($allowed) == 0) {
        my int $sep = index($origin, "://");
        if ($sep < 0) { return 0; }
        my str $ohost = lc(substr($origin, $sep + 3, length($origin) - $sep - 3));
        my int $slash = index($ohost, "/");
        if ($slash >= 0) { $ohost = substr($ohost, 0, $slash); }
        my str $h = lc($host);
        if ($ohost eq $h) { return 1; }
        # default ports may be implicit on either side
        if ($ohost . ":80" eq $h || $ohost . ":443" eq $h || $h . ":80" eq $ohost || $h . ":443" eq $ohost) { return 1; }
        return 0;
    }
    foreach my str $raw (split(",", $allowed)) {
        my str $o = trim($raw);
        if (lc($o) eq lc($origin)) { return 1; }
    }
    return 0;
}

# Create a WebSocket connection from a request hash
func Cannoli_WebSocket_from_request(hash %req) scalar {
    my hash %ws = ();

    # bytes the client sent right after the upgrade request
    $ws{"_buffer"} = exists(%req, "_conn_buffer") ? $req{"_conn_buffer"} : "";
    $ws{"_ssl"} = 0;
    $ws{"_client"} = undef;
    $ws{"closed"} = 0;
    $ws{"close_sent"} = 0;
    $ws{"max_message"} = 1048576;
    $ws{"close_code"} = 0;

    if (exists(%req, "_ssl") && $req{"_ssl"} == 1) {
        $ws{"_ssl"} = 1;
        $ws{"_ssl_conn"} = $req{"_ssl_conn"};
        $ws{"_ssl_read_fn"} = $req{"_ssl_read_fn"};
        $ws{"_ssl_write_fn"} = $req{"_ssl_write_fn"};
        $ws{"_ssl_close_fn"} = $req{"_ssl_close_fn"};
        if (exists(%req, "_ssl_try_read_fn")) {
            $ws{"_ssl_try_read_fn"} = $req{"_ssl_try_read_fn"};
            $ws{"_ssl_want_fn"} = $req{"_ssl_want_fn"};
            $ws{"_ssl_fd"} = $req{"_ssl_fd"};
        }
    } else {
        $ws{"_client"} = $req{"_client"};
        $ws{"_fd"} = $req{"_fd"};
    }

    return \%ws;
}

# Perform WebSocket handshake and return ws handle (undef on failure)
func Cannoli_WebSocket_accept(hash %req, str $protocol = "") scalar {
    if (::is_upgrade_request(%req) == 0) {
        return undef;
    }

    my str $version = Cannoli::Request::get_header(%req, "Sec-WebSocket-Version");
    if ($version ne "13") {
        return undef;
    }

    my str $key = trim(Cannoli::Request::get_header(%req, "Sec-WebSocket-Key"));
    # 16 random bytes, base64: 24 characters ending in "=="
    if (length($key) != 24 || $key !~ /^[A-Za-z0-9+\/]{22}==$/) {
        return undef;
    }
    if (length($protocol) > 0 && $protocol =~ /[\x00-\x20\x7f,;]/) {
        return undef;
    }

    my str $accept = ::make_accept($key);
    my str $resp = "HTTP/1.1 101 Switching Protocols\r\n";
    $resp = $resp . "Upgrade: websocket\r\n";
    $resp = $resp . "Connection: Upgrade\r\n";
    $resp = $resp . "Sec-WebSocket-Accept: " . $accept . "\r\n";

    if (length($protocol) > 0) {
        $resp = $resp . "Sec-WebSocket-Protocol: " . $protocol . "\r\n";
    }

    $resp = $resp . "\r\n";

    my int $written = ::write_response(%req, $resp);
    if ($written <= 0) {
        return undef;
    }

    return ::from_request(%req);
}

# Send a text message (opcode 1)
func Cannoli_WebSocket_send_text(scalar $ws, str $payload) int {
    return ::send_frame($ws, 1, $payload);
}

# Send a binary message (opcode 2)
func Cannoli_WebSocket_send_binary(scalar $ws, str $payload) int {
    return ::send_frame($ws, 2, $payload);
}

# Send ping (opcode 9); control payloads are limited to 125 bytes
func Cannoli_WebSocket_send_ping(scalar $ws, str $payload) int {
    if (core::byte_length($payload) > 125) { return -1; }
    return ::send_frame($ws, 9, $payload);
}

# Send pong (opcode 10)
func Cannoli_WebSocket_send_pong(scalar $ws, str $payload) int {
    if (core::byte_length($payload) > 125) { return -1; }
    return ::send_frame($ws, 10, $payload);
}

# Cut $s to at most $max bytes without splitting a UTF-8 character.
func Cannoli_WebSocket_utf8_truncate(str $s, int $max) str {
    if (core::byte_length($s) <= $max) { return $s; }
    my int $n = $max;
    # step back over continuation bytes (10xxxxxx) to a character start
    while ($n > 0 && (core::get_byte($s, $n) % 256) >= 128 && (core::get_byte($s, $n) % 256) < 192) {
        $n = $n - 1;
    }
    return core::byte_substr($s, 0, $n);
}

# Send close frame (opcode 8), once
func Cannoli_WebSocket_send_close(scalar $ws, int $code, str $reason) int {
    if ($ws->{"close_sent"} == 1) { return 0; }
    my str $payload = "";
    if ($code > 0) {
        # Control frames must not exceed 125 bytes total (2-byte code + 123-byte reason)
        $payload = ::pack_u16($code) . ::utf8_truncate($reason, 123);
    }
    $ws->{"close_sent"} = 1;
    return ::send_frame($ws, 8, $payload);
}

# Close the WebSocket: send a close frame and stop using the connection.
# The server closes the socket itself once the handler returns (closing it
# here as well would close -- for TLS, free -- it twice).
func Cannoli_WebSocket_close(scalar $ws, int $code, str $reason) void {
    ::send_close($ws, $code, $reason);
    ::close_socket($ws);
}

# Protocol violation: close with $code (1002 protocol error, 1007 bad
# UTF-8, 1009 too big) and report end of stream.
func Cannoli_WebSocket_fail(scalar $ws, int $code) scalar {
    $ws->{"close_code"} = $code;
    ::close($ws, $code, "");
    return undef;
}

# Receive a single frame, returns hash {fin, opcode, payload} or undef on
# EOF or a protocol violation (RFC 6455 5.2-5.5: client frames must be
# masked, RSV bits clear, control frames short and unfragmented, lengths
# within max_message).
func Cannoli_WebSocket_recv_frame(scalar $ws) scalar {
    if ($ws->{"closed"} == 1) { return undef; }
    if (!defined($ws->{"max_message"}) || $ws->{"max_message"} <= 0) { $ws->{"max_message"} = 1048576; }
    if (::ensure_bytes($ws, 2) == 0) {
        return undef;
    }

    my str $buffer = $ws->{"_buffer"};
    my int $b1 = core::get_byte($buffer, 0) % 256;
    my int $b2 = core::get_byte($buffer, 1) % 256;

    my int $fin = $b1 / 128;
    my int $rsv = ($b1 / 16) % 8;
    my int $opcode = $b1 % 16;
    my int $masked = $b2 / 128;
    my int $payload_len = $b2 % 128;
    my int $offset = 2;

    if ($rsv != 0) { return ::fail($ws, 1002); }
    if (($opcode >= 3 && $opcode <= 7) || $opcode >= 11) { return ::fail($ws, 1002); }
    if ($masked != 1) { return ::fail($ws, 1002); }
    if ($opcode >= 8 && ($fin != 1 || $payload_len > 125)) { return ::fail($ws, 1002); }

    if ($payload_len == 126) {
        if (::ensure_bytes($ws, $offset + 2) == 0) {
            return undef;
        }
        $buffer = $ws->{"_buffer"};
        $payload_len = (core::get_byte($buffer, $offset) % 256) * 256 + (core::get_byte($buffer, $offset + 1) % 256);
        $offset = $offset + 2;
    } elsif ($payload_len == 127) {
        if (::ensure_bytes($ws, $offset + 8) == 0) {
            return undef;
        }
        $buffer = $ws->{"_buffer"};
        if ((core::get_byte($buffer, $offset) % 256) >= 128) { return ::fail($ws, 1002); }
        my int $len = 0;
        my int $i = 0;
        while ($i < 8) {
            if ($len > $ws->{"max_message"}) { return ::fail($ws, 1009); }
            $len = ($len * 256) + (core::get_byte($buffer, $offset + $i) % 256);
            $i = $i + 1;
        }
        $payload_len = $len;
        $offset = $offset + 8;
    }
    if ($payload_len > $ws->{"max_message"}) { return ::fail($ws, 1009); }

    if (::ensure_bytes($ws, $offset + 4) == 0) {
        return undef;
    }
    $buffer = $ws->{"_buffer"};
    my int $mask0 = core::get_byte($buffer, $offset) % 256;
    my int $mask1 = core::get_byte($buffer, $offset + 1) % 256;
    my int $mask2 = core::get_byte($buffer, $offset + 2) % 256;
    my int $mask3 = core::get_byte($buffer, $offset + 3) % 256;
    $offset = $offset + 4;

    if (::ensure_bytes($ws, $offset + $payload_len) == 0) {
        return undef;
    }
    $buffer = $ws->{"_buffer"};

    my str $payload = "";
    if ($payload_len > 0) {
        $payload = ::unmask(core::byte_substr($buffer, $offset, $payload_len), $mask0, $mask1, $mask2, $mask3);
    }

    my int $remaining_start = $offset + $payload_len;
    my int $remaining_len = core::byte_length($buffer) - $remaining_start;
    if ($remaining_len > 0) {
        $ws->{"_buffer"} = core::byte_substr($buffer, $remaining_start, $remaining_len);
    } else {
        $ws->{"_buffer"} = "";
    }

    my hash %frame = ();
    $frame{"fin"} = $fin;
    $frame{"opcode"} = $opcode;
    $frame{"payload"} = $payload;
    return \%frame;
}

# Receive one complete message: {type => "text"|"binary", data => ...}.
# Answers pings, ignores pongs, reassembles fragments, validates UTF-8 in
# text, and completes the close handshake. Returns undef once the
# connection is closed ($ws->{"close_code"} holds the peer's/our code).
func Cannoli_WebSocket_recv_message(scalar $ws) scalar {
    my str $data = "";
    my int $msg_opcode = 0;
    while (1) {
        my scalar $f = ::recv_frame($ws);
        if (!defined($f)) {
            if ($ws->{"closed"} == 0) { ::close_socket($ws); }
            return undef;
        }
        my int $op = $f->{"opcode"};
        if ($op == 9) {
            ::send_pong($ws, $f->{"payload"});
            next;
        }
        if ($op == 10) { next; }
        if ($op == 8) {
            my str $cp = $f->{"payload"};
            my int $code = 1005;
            if (core::byte_length($cp) == 1) { return ::fail($ws, 1002); }
            if (core::byte_length($cp) >= 2) {
                $code = (core::get_byte($cp, 0) % 256) * 256 + (core::get_byte($cp, 1) % 256);
                if (::valid_utf8(core::byte_substr($cp, 2, core::byte_length($cp) - 2)) == 0) { return ::fail($ws, 1007); }
            }
            $ws->{"close_code"} = $code;
            ::send_close($ws, ($code == 1005 ? 1000 : $code), "");
            ::close_socket($ws);
            return undef;
        }
        if ($op == 0) {
            if ($msg_opcode == 0) { return ::fail($ws, 1002); }   # continuation without a start
        } else {
            if ($msg_opcode != 0) { return ::fail($ws, 1002); }   # new message inside a fragmented one
            $msg_opcode = $op;
        }
        if (core::byte_length($data) + core::byte_length($f->{"payload"}) > $ws->{"max_message"}) {
            return ::fail($ws, 1009);
        }
        $data = $data . $f->{"payload"};
        if ($f->{"fin"} == 1) {
            if ($msg_opcode == 1 && ::valid_utf8($data) == 0) { return ::fail($ws, 1007); }
            return {"type" => ($msg_opcode == 1 ? "text" : "binary"), "data" => $data};
        }
    }
    return undef;
}

# ============================================================
# Internal helpers (binary/frame building)
# ============================================================

func Cannoli_WebSocket_send_frame(scalar $ws, int $opcode, str $payload) int {
    if ($ws->{"closed"} == 1) { return -1; }
    my int $len = core::byte_length($payload);
    my int $byte1 = 128 + ($opcode % 16);
    my str $header = core::byte($byte1);

    if ($len <= 125) {
        $header = $header . core::byte($len);
    } elsif ($len <= 65535) {
        $header = $header . core::byte(126) . ::pack_u16($len);
    } else {
        $header = $header . core::byte(127) . ::pack_u64($len);
    }

    return ::write_ws($ws, $header . $payload);
}

func Cannoli_WebSocket_pack_u16(int $value) str {
    return core::pack("n", $value);
}

func Cannoli_WebSocket_pack_u64(num $value) str {
    my num $len = $value;
    my int $high = math::floor($len / 4294967296);
    my int $low = $len - ($high * 4294967296);
    return core::pack("N2", $high, $low);
}

# Write all of $data (parks the task in loop workers).
func Cannoli_WebSocket_write_ws(scalar $ws, str $data) int {
    if ($ws->{"_ssl"} == 1) {
        my scalar $ssl_conn = $ws->{"_ssl_conn"};
        my scalar $ssl_write_fn = $ws->{"_ssl_write_fn"};
        return core::dl_call_int_sv($ssl_write_fn, [$ssl_conn, $data]);
    }
    if (defined($ws->{"_client"})) {
        return Async::Task::send($ws->{"_client"}, $data);
    }
    return core::write_fd($ws->{"_fd"}, $data);   # handle built around a bare fd
}

# Stop reading/writing. Plain sockets are shut down so the peer sees EOF
# right away; the server closes (and frees) the connection afterwards.
func Cannoli_WebSocket_close_socket(scalar $ws) void {
    if ($ws->{"closed"} == 1) { return; }
    $ws->{"closed"} = 1;
    if ($ws->{"_ssl"} != 1 && defined($ws->{"_client"})) {
        core::shutdown($ws->{"_client"}, 2);
    }
}

func Cannoli_WebSocket_write_response(hash %req, str $data) int {
    if (exists(%req, "_ssl") && $req{"_ssl"} == 1) {
        my scalar $ssl_conn = $req{"_ssl_conn"};
        my scalar $ssl_write_fn = $req{"_ssl_write_fn"};
        return core::dl_call_int_sv($ssl_write_fn, [$ssl_conn, $data]);
    }
    return Async::Task::send($req{"_client"}, $data);
}

# Read up to $len bytes, waiting as long as it takes (WebSockets idle).
func Cannoli_WebSocket_read_ws(scalar $ws, int $len) str {
    if ($ws->{"_ssl"} == 1) {
        my scalar $ssl_conn = $ws->{"_ssl_conn"};
        if (exists(%{$ws}, "_ssl_try_read_fn") && defined($ws->{"_ssl_try_read_fn"})) {
            while (1) {
                my scalar $chunk = core::dl_call_sv($ws->{"_ssl_try_read_fn"}, [$ssl_conn, $len]);
                if (defined($chunk)) { return $chunk; }
                my int $want = core::dl_call_int_sv($ws->{"_ssl_want_fn"}, [$ssl_conn]);
                Cannoli::Server::wait_fd($ws->{"_ssl_fd"}, $want == 2 ? "w" : "r", 60000);
            }
        }
        my scalar $ssl_read_fn = $ws->{"_ssl_read_fn"};
        return core::dl_call_str_sv($ssl_read_fn, [$ssl_conn, $len]);
    }
    if (!defined($ws->{"_client"})) {
        my scalar $raw = core::read_fd($ws->{"_fd"}, $len);
        return defined($raw) ? $raw : "";
    }
    my scalar $d = Async::Task::recv($ws->{"_client"}, $len);
    return defined($d) ? $d : "";
}

func Cannoli_WebSocket_ensure_bytes(scalar $ws, int $needed) int {
    my str $buffer = $ws->{"_buffer"};
    while (core::byte_length($buffer) < $needed) {
        my str $chunk = ::read_ws($ws, 65536);
        if (core::byte_length($chunk) == 0) {
            $ws->{"_buffer"} = $buffer;
            return 0;
        }
        $buffer = $buffer . $chunk;
    }
    $ws->{"_buffer"} = $buffer;
    return 1;
}

func Cannoli_WebSocket_make_accept(str $key) str {
    my str $digest = ::sha1_bin($key . ::guid());
    return core::base64_encode($digest);
}

# ============================================================
# SHA1 implementation (pure Strada, uses arithmetic-only bit ops)
# ============================================================

func Cannoli_WebSocket_sha1_bin(str $data) str {
    my int $len = core::byte_length($data);
    my array @bytes = ();

    my int $i = 0;
    while ($i < $len) {
        push(@bytes, core::get_byte($data, $i));
        $i = $i + 1;
    }

    # Append 0x80 then pad with 0x00 to 56 mod 64
    push(@bytes, 128);
    while ((scalar(@bytes) % 64) != 56) {
        push(@bytes, 0);
    }

    # Append length in bits as 64-bit big-endian
    my num $bit_len = $len * 8;
    my array @len_bytes = (0, 0, 0, 0, 0, 0, 0, 0);
    $i = 7;
    while ($i >= 0) {
        $len_bytes[$i] = $bit_len % 256;
        $bit_len = math::floor($bit_len / 256);
        $i = $i - 1;
    }
    $i = 0;
    while ($i < 8) {
        push(@bytes, $len_bytes[$i]);
        $i = $i + 1;
    }

    my int $h0 = 1732584193;
    my int $h1 = 4023233417;
    my int $h2 = 2562383102;
    my int $h3 = 271733878;
    my int $h4 = 3285377520;

    my int $chunk = 0;
    my int $total = scalar(@bytes);
    while ($chunk < $total) {
        my array @w = ();
        $i = 0;
        while ($i < 16) {
            my int $idx = $chunk + ($i * 4);
            my int $b0 = $bytes[$idx];
            my int $b1 = $bytes[$idx + 1];
            my int $b2 = $bytes[$idx + 2];
            my int $b3 = $bytes[$idx + 3];
            my int $word = ($b0 * 16777216) + ($b1 * 65536) + ($b2 * 256) + $b3;
            push(@w, $word);
            $i = $i + 1;
        }

        $i = 16;
        while ($i < 80) {
            my int $v = ::xor32(::xor32($w[$i - 3], $w[$i - 8]), ::xor32($w[$i - 14], $w[$i - 16]));
            my int $word = ::rol32($v, 1);
            push(@w, $word);
            $i = $i + 1;
        }

        my int $a = $h0;
        my int $b = $h1;
        my int $c = $h2;
        my int $d = $h3;
        my int $e = $h4;

        $i = 0;
        while ($i < 80) {
            my int $f = 0;
            my int $k = 0;

            if ($i < 20) {
                $f = ::or32(::and32($b, $c), ::and32(::not32($b), $d));
                $k = 1518500249;
            } elsif ($i < 40) {
                $f = ::xor32(::xor32($b, $c), $d);
                $k = 1859775393;
            } elsif ($i < 60) {
                $f = ::or32(::or32(::and32($b, $c), ::and32($b, $d)), ::and32($c, $d));
                $k = 2400959708;
            } else {
                $f = ::xor32(::xor32($b, $c), $d);
                $k = 3395469782;
            }

            my int $temp = ::add32(::rol32($a, 5), $f, $e, $k, $w[$i]);
            $e = $d;
            $d = $c;
            $c = ::rol32($b, 30);
            $b = $a;
            $a = $temp;

            $i = $i + 1;
        }

        $h0 = ::add32($h0, $a);
        $h1 = ::add32($h1, $b);
        $h2 = ::add32($h2, $c);
        $h3 = ::add32($h3, $d);
        $h4 = ::add32($h4, $e);

        $chunk = $chunk + 64;
    }

    my str $out = "";
    $out = $out . core::pack("N", ::u32($h0));
    $out = $out . core::pack("N", ::u32($h1));
    $out = $out . core::pack("N", ::u32($h2));
    $out = $out . core::pack("N", ::u32($h3));
    $out = $out . core::pack("N", ::u32($h4));
    return $out;
}

func Cannoli_WebSocket_add32(int ...@vals) int {
    my num $sum = 0;
    my int $i = 0;
    while ($i < scalar(@vals)) {
        $sum = $sum + $vals[$i];
        $i = $i + 1;
    }
    return ::u32($sum);
}

func Cannoli_WebSocket_u32(num $value) int {
    my num $mod = 4294967296;
    my num $div = $value / $mod;
    my int $q = math::floor($div);
    my num $res = $value - ($q * $mod);
    if ($res < 0) {
        $res = $res + $mod;
    }
    return $res;
}

func Cannoli_WebSocket_pow2(int $n) num {
    my num $v = 1;
    my int $i = 0;
    while ($i < $n) {
        $v = $v * 2;
        $i = $i + 1;
    }
    return $v;
}

func Cannoli_WebSocket_rol32(int $value, int $bits) int {
    my int $shift = $bits % 32;
    if ($shift == 0) {
        return ::u32($value);
    }
    my num $pow = ::pow2($shift);
    my num $pow_rev = ::pow2(32 - $shift);
    my int $left = ::u32($value * $pow);
    my int $right = ::u32($value / $pow_rev);
    return ::u32($left + $right);
}

func Cannoli_WebSocket_and32(int $a, int $b) int {
    my int $aa = ::u32($a);
    my int $bb = ::u32($b);
    my int $result = 0;
    my int $bit = 1;
    my int $i = 0;

    while ($i < 32) {
        if (($aa % 2) == 1 && ($bb % 2) == 1) {
            $result = $result + $bit;
        }
        $aa = $aa / 2;
        $bb = $bb / 2;
        $bit = $bit * 2;
        $i = $i + 1;
    }

    return $result;
}

func Cannoli_WebSocket_or32(int $a, int $b) int {
    my int $aa = ::u32($a);
    my int $bb = ::u32($b);
    my int $result = 0;
    my int $bit = 1;
    my int $i = 0;

    while ($i < 32) {
        if (($aa % 2) == 1 || ($bb % 2) == 1) {
            $result = $result + $bit;
        }
        $aa = $aa / 2;
        $bb = $bb / 2;
        $bit = $bit * 2;
        $i = $i + 1;
    }

    return $result;
}

func Cannoli_WebSocket_xor32(int $a, int $b) int {
    my int $aa = ::u32($a);
    my int $bb = ::u32($b);
    my int $result = 0;
    my int $bit = 1;
    my int $i = 0;

    while ($i < 32) {
        my int $bit_val = ($aa % 2) + ($bb % 2);
        if (($bit_val % 2) == 1) {
            $result = $result + $bit;
        }
        $aa = $aa / 2;
        $bb = $bb / 2;
        $bit = $bit * 2;
        $i = $i + 1;
    }

    return $result;
}

func Cannoli_WebSocket_not32(int $a) int {
    return ::u32(4294967295 - ::u32($a));
}

func Cannoli_WebSocket_xor8(int $a, int $b) int {
    my int $aa = $a % 256;
    my int $bb = $b % 256;
    my int $result = 0;
    my int $bit = 1;
    my int $i = 0;

    while ($i < 8) {
        my int $bit_val = ($aa % 2) + ($bb % 2);
        if (($bit_val % 2) == 1) {
            $result = $result + $bit;
        }
        $aa = $aa / 2;
        $bb = $bb / 2;
        $bit = $bit * 2;
        $i = $i + 1;
    }

    return $result;
}
