package Cannoli::Server;

# Libraries may export cannoli_worker_exit(): called once in each worker
# just before it exits (max_requests reached, SIGTERM, orphaned, admin
# kill) so they can close database connections and other resources.
my scalar $_g_exit_funcs = [];
# Libraries may export cannoli_tick(): when one does, the master runs one
# extra process, the ticker, that calls it every server.tick_interval
# seconds (default 30; 0 turns the ticker off) for background jobs. It is
# respawned like a worker and gets SIGTERM and cannoli_worker_exit too.
my scalar $_g_tick_funcs = [];
my int $_g_worker_busy = 0;      # inside a request: SIGTERM waits for it
my int $_g_exit_requested = 0;
my int $_g_exiting = 0;
my int $_g_reload_requested = 0;


# cannoli/src/server.strada - Preforking HTTP server
#
# A preforking server that spawns multiple worker processes to handle
# incoming HTTP connections. Based on the classic Unix preforking model.
#
# Features:
#   - Dynamic library loading (multiple libraries supported, comma-separated)
#   - SSL/HTTPS support
#   - Regex and prefix matching with path_info
#
# Library interface:
#   cannoli_dispatch($c) -> response_body
#   cannoli_after_request($c, $elapsed_ms) -> void  (optional, called after response sent)
#   $c is a Cannoli object with all request data and response methods

# Create a new server from configuration
# Returns a reference to the server hash
use Async::Loop;
use Async::Task;

func Cannoli_Server_new(hash %config) scalar {
    $_g_exit_funcs = [];
    $_g_tick_funcs = [];
    $_g_reload_requested = 0;

    my hash %server = ();

    $server{"host"} = Cannoli::Config::get_str(%config, "server.host", "::");
    $server{"port"} = Cannoli::Config::get_int(%config, "server.port", 8080);
    $server{"num_workers"} = Cannoli::Config::get_int(%config, "server.workers", 5);
    $server{"max_requests"} = Cannoli::Config::get_int(%config, "server.max_requests", 1000);
    $server{"tick_interval"} = Cannoli::Config::get_int(%config, "server.tick_interval", 30);
    $server{"tick_max"} = Cannoli::Config::get_int(%config, "server.tick_max", 1000);
    # tickers: how many ticker processes (each calls cannoli_tick on its own
    # schedule; a library can use several to work through a job queue)
    $server{"tickers"} = Cannoli::Config::get_int(%config, "server.tickers", 1);
    $server{"ticker_pids"} = [];
    # http = 0: no listening socket and no request workers, only the
    # tickers (a background-job server)
    $server{"http"} = Cannoli::Config::get_bool(%config, "server.http", 1);
    $server{"timeout"} = Cannoli::Config::get_int(%config, "server.timeout", 30);
    $server{"keep_alive_enabled"} = Cannoli::Config::get_bool(%config, "server.keep_alive", 1);
    # Idle timeout for a kept-alive connection between requests (seconds). Kept
    # short so a prefork worker parked on an idle keep-alive connection returns to
    # accept() promptly instead of starving new connections; the value is also
    # advertised in the Keep-Alive header so clients recycle on the same schedule.
    $server{"keep_alive_timeout"} = Cannoli::Config::get_int(%config, "server.keep_alive_timeout", 2);
    $server{"loop_mode"} = Cannoli::Config::get_bool(%config, "server.loop_workers", 0);
    $server{"loop_acceptors"} = Cannoli::Config::get_int(%config, "server.loop_acceptors", 2);
    $server{"backlog"} = Cannoli::Config::get_int(%config, "server.backlog", 128);
    $server{"max_body_size"} = Cannoli::Config::get_int(%config, "server.max_body_size", 10485760);
    $server{"max_header_size"} = Cannoli::Config::get_int(%config, "server.max_header_size", 8192);
    # Total time allowed for a request's header block (and a TLS handshake):
    # the slowloris bound. server.timeout stays the per-read silence limit.
    $server{"header_timeout"} = Cannoli::Config::get_int(%config, "server.header_timeout", 20);
    # A body must keep arriving at >= body_min_rate bytes/s once
    # server.timeout seconds have passed (0 = no rate floor).
    $server{"body_min_rate"} = Cannoli::Config::get_int(%config, "server.body_min_rate", 1024);
    # A response write fails after this many seconds without progress.
    $server{"write_timeout"} = Cannoli::Config::get_int(%config, "server.write_timeout", $server{"timeout"});
    # Seconds a stopping (shutdown) or retiring (SIGHUP) worker gets to
    # finish before SIGKILL.
    $server{"shutdown_timeout"} = Cannoli::Config::get_int(%config, "server.shutdown_timeout", 10);
    $server{"pid_file"} = Cannoli::Config::get_str(%config, "server.pid_file", "");
    $server{"user"} = Cannoli::Config::get_str(%config, "server.user", "");
    $server{"group"} = Cannoli::Config::get_str(%config, "server.group", "");
    # Proxies whose X-Forwarded-For / X-Forwarded-Proto / X-Request-Id are
    # believed (addresses and IPv4 CIDR blocks, comma-separated).
    $server{"trusted_proxies"} = Cannoli::Config::get_str(%config, "server.trusted_proxies", "");
    $server{"request_id_header"} = Cannoli::Config::get_bool(%config, "server.request_id", 1);
    $server{"server_tokens"} = Cannoli::Config::get_bool(%config, "server.tokens", 1);
    # [headers] section: added to every response that doesn't set them,
    # e.g. X-Content-Type-Options = nosniff
    my hash %extra_headers = ();
    foreach my str $ck (keys(%config)) {
        if (length($ck) > 8 && substr($ck, 0, 8) eq "headers.") {
            $extra_headers{substr($ck, 8, length($ck) - 8)} = "" . $config{$ck};
        }
    }
    $server{"extra_headers"} = \%extra_headers;
    $server{"retire_deadlines"} = {};
    $server{"spawn_times"} = {};
    $server{"crash_streak"} = 0;
    $server{"single_process"} = 0;
    $server{"router"} = undef;
    $server{"server_sock"} = undef;
    $server{"running"} = 0;
    $server{"worker_pids"} = [];
    $server{"retiring_pids"} = {};

    # SSL configuration
    $server{"ssl_enabled"} = Cannoli::Config::get_bool(%config, "ssl.enabled", 0);
    $server{"ssl_requested"} = $server{"ssl_enabled"};
    $server{"ssl_only"} = Cannoli::Config::get_bool(%config, "ssl.only", 0);
    $server{"ssl_port"} = Cannoli::Config::get_int(%config, "ssl.port", 443);
    $server{"ssl_cert"} = Cannoli::Config::get_str(%config, "ssl.cert", "");
    $server{"ssl_key"} = Cannoli::Config::get_str(%config, "ssl.key", "");

    # Admin endpoint configuration
    $server{"admin_enabled"} = Cannoli::Config::get_bool(%config, "admin.enabled", 0);
    $server{"admin_path"} = Cannoli::Config::get_str(%config, "admin.path", "/__admin");
    $server{"admin_allowed_ips"} = Cannoli::Config::get_str(%config, "admin.allowed_ips", "127.0.0.1, ::1");

    $server{"ssl_ctx"} = undef;
    $server{"ssl_server"} = undef;
    $server{"ssl_lib"} = undef;
    $server{"ssl_accept_fn"} = undef;
    $server{"ssl_read_fn"} = undef;
    $server{"ssl_write_fn"} = undef;
    $server{"ssl_close_fn"} = undef;

    # Dynamic library support
    # New style: library./prefix = path.so (prefix-based routing)
    # Old style: app.library = path1.so,path2.so (chain of responsibility)
    $server{"app_library"} = Cannoli::Config::get_str(%config, "app.library", "");
    $server{"lib_handles"} = [];       # Array of library handles
    $server{"dispatch_funcs"} = [];    # Array of dispatch functions (old style)
    $server{"after_funcs"} = [];       # Array of after-request functions (old style)
    $server{"library_routes"} = [];    # Array of {prefix, dispatch_func} (new style)

    # Load SSL library if SSL is enabled
    if ($server{"ssl_enabled"} == 1) {
        # STRADA_SSL_LIB env override wins; then installed path; then dev path.
        my str $ssl_lib_path = core::getenv("STRADA_SSL_LIB");
        my scalar $ssl_lib = undef;
        if (defined($ssl_lib_path) && $ssl_lib_path ne "") {
            $ssl_lib = core::dl_open($ssl_lib_path);
        }
        if (!defined($ssl_lib)) {
            $ssl_lib_path = "/usr/local/lib/strada/lib/ssl/libstrada_ssl.so";
            $ssl_lib = core::dl_open($ssl_lib_path);
        }
        if (!defined($ssl_lib)) {
            $ssl_lib_path = "../lib/ssl/libstrada_ssl.so";
            $ssl_lib = core::dl_open($ssl_lib_path);
        }
        say("Loading SSL library: " . $ssl_lib_path);
        if (defined($ssl_lib)) {
            $server{"ssl_lib"} = $ssl_lib;
            $server{"ssl_server_fn"} = core::dl_sym($ssl_lib, "strada_ssl_server_sv");
            # Host-aware TLS listener (IPv6 / dual-stack). Older SSL libraries
            # lack it — create_ssl_socket falls back to ssl_server_fn (which is
            # also dual-stack once the lib is rebuilt).
            $server{"ssl_server_host_fn"} = core::dl_sym($ssl_lib, "strada_ssl_server_host_sv");
            $server{"ssl_accept_fn"} = core::dl_sym($ssl_lib, "strada_ssl_accept_sv");
            $server{"ssl_read_fn"} = core::dl_sym($ssl_lib, "strada_ssl_read_sv");
            $server{"ssl_write_fn"} = core::dl_sym($ssl_lib, "strada_ssl_write_sv");
            $server{"ssl_close_fn"} = core::dl_sym($ssl_lib, "strada_ssl_close_sv");
            $server{"ssl_fd_fn"} = core::dl_sym($ssl_lib, "strada_ssl_fd_sv");
            # Non-blocking variants for loop workers (undef on older SSL
            # libraries -- loop mode then leaves the TLS port unserved with
            # a warning, same as before).
            $server{"ssl_try_accept_fn"} = core::dl_sym($ssl_lib, "strada_ssl_try_accept_sv");
            $server{"ssl_handshake_step_fn"} = core::dl_sym($ssl_lib, "strada_ssl_handshake_step_sv");
            $server{"ssl_try_read_fn"} = core::dl_sym($ssl_lib, "strada_ssl_try_read_sv");
            $server{"ssl_try_write_fn"} = core::dl_sym($ssl_lib, "strada_ssl_try_write_sv");
            $server{"ssl_want_fn"} = core::dl_sym($ssl_lib, "strada_ssl_want_sv");
            say("  SSL library loaded");
            if (defined($server{"ssl_server_fn"})) {
                say("  Found strada_ssl_server_sv");
            } else {
                say("  ERROR: strada_ssl_server_sv not found!");
            }
        } else {
            say("  Warning: Could not load SSL library");
            $server{"ssl_enabled"} = 0;
        }
    }

    # Load dynamic libraries if specified
    my str $lib_paths = $server{"app_library"};
    if (length($lib_paths) > 0) {
        my array @paths = split(",", $lib_paths);
        my int $i = 0;
        while ($i < scalar(@paths)) {
            my str $lib_spec = trim($paths[$i]);
            if (length($lib_spec) > 0) {
                # Parse library spec: path.so or path.so:config
                my str $lib_path = $lib_spec;
                my str $lib_config = "";

                # Find first colon (config separator)
                my int $colon_pos = -1;
                my int $k = 0;
                while ($k < length($lib_spec)) {
                    if (substr($lib_spec, $k, 1) eq ":") {
                        $colon_pos = $k;
                        last;
                    }
                    $k = $k + 1;
                }

                if ($colon_pos > 0) {
                    $lib_path = substr($lib_spec, 0, $colon_pos);
                    $lib_config = substr($lib_spec, $colon_pos + 1, length($lib_spec) - $colon_pos - 1);
                }

                say("Loading library: " . $lib_path);
                if (length($lib_config) > 0) {
                    say("  Config: " . $lib_config);
                }

                my scalar $lib = core::dl_open($lib_path);
                if (defined($lib)) {
                    # Call cannoli_init if it exists (for libraries that need configuration)
                    my scalar $init_sym = core::dl_sym($lib, "cannoli_init");
                    if (defined($init_sym)) {
                        # cannoli_init is a Strada function: it returns a StradaValue, not a C
                        # int (a tagged 0 is the non-NULL pointer 1, so dl_call_int_sv read
                        # every failure as success). Call it like cannoli_dispatch and test it.
                        my scalar $init_ret = core::dl_call_sv($init_sym, [$lib_config]);
                        my int $init_result = 0;
                        if (defined($init_ret) && $init_ret) { $init_result = 1; }
                        if ($init_result == 0) {
                            say("  Error: cannoli_init failed");
                            $i = $i + 1;
                            next;
                        }
                        say("  Initialized: cannoli_init");
                    }

                    my scalar $sym = core::dl_sym($lib, "cannoli_dispatch");
                    if (defined($sym)) {
                        push(@{$server{"lib_handles"}}, $lib);
                        push(@{$server{"dispatch_funcs"}}, $sym);
                        say("  Loaded: cannoli_dispatch");

                        my scalar $after_sym = core::dl_sym($lib, "cannoli_after_request");
                        push(@{$server{"after_funcs"}}, $after_sym);
                        my scalar $exit_sym = core::dl_sym($lib, "cannoli_worker_exit");
                        if (defined($exit_sym)) { push(@{$_g_exit_funcs}, $exit_sym); }
                        my scalar $tick_sym = core::dl_sym($lib, "cannoli_tick");
                        if (defined($tick_sym)) { push(@{$_g_tick_funcs}, $tick_sym); say("  Loaded: cannoli_tick"); }
                        if (defined($after_sym)) {
                            say("  Loaded: cannoli_after_request");
                        }
                    } else {
                        say("  Warning: cannoli_dispatch not found");
                    }
                } else {
                    say("  Error: Could not load library");
                }
            }
            $i = $i + 1;
        }
    }

    # Load prefix-based library routes (new style: library./prefix = path.so:config)
    my scalar $lib_routes = Cannoli::Config::get_library_routes(%config);
    my int $num_routes = scalar(@{$lib_routes});
    if ($num_routes > 0) {
        say("=== Library Routes ===");
        my int $j = 0;
        while ($j < $num_routes) {
            my scalar $route = $lib_routes->[$j];
            my str $prefix = $route->{"prefix"};
            my str $lib_spec = $route->{"path"};

            # Parse library spec: path.so or path.so:config
            my str $lib_path = $lib_spec;
            my str $lib_config = "";

            my int $colon_pos = -1;
            my int $k = 0;
            while ($k < length($lib_spec)) {
                if (substr($lib_spec, $k, 1) eq ":") {
                    $colon_pos = $k;
                    last;
                }
                $k = $k + 1;
            }

            if ($colon_pos > 0) {
                $lib_path = substr($lib_spec, 0, $colon_pos);
                $lib_config = substr($lib_spec, $colon_pos + 1, length($lib_spec) - $colon_pos - 1);
            }

            say("  " . $prefix . " -> " . $lib_path);
            if (length($lib_config) > 0) {
                say("    Config: " . $lib_config);
            }

            my scalar $lib = core::dl_open($lib_path);
            if (defined($lib)) {
                # Call cannoli_init if it exists
                my scalar $init_sym = core::dl_sym($lib, "cannoli_init");
                if (defined($init_sym)) {
                    # cannoli_init is a Strada function: it returns a StradaValue, not a C
                    # int (a tagged 0 is the non-NULL pointer 1, so dl_call_int_sv read
                    # every failure as success). Call it like cannoli_dispatch and test it.
                    my scalar $init_ret = core::dl_call_sv($init_sym, [$lib_config]);
                    my int $init_result = 0;
                    if (defined($init_ret) && $init_ret) { $init_result = 1; }
                    if ($init_result == 0) {
                        say("    Error: cannoli_init failed");
                        $j = $j + 1;
                        next;
                    }
                    say("    Initialized: cannoli_init");
                }

                my scalar $sym = core::dl_sym($lib, "cannoli_dispatch");
                if (defined($sym)) {
                    push(@{$server{"lib_handles"}}, $lib);
                    my hash %lib_route = ();
                    $lib_route{"prefix"} = $prefix;
                    $lib_route{"dispatch"} = $sym;
                    $lib_route{"after"} = core::dl_sym($lib, "cannoli_after_request");
                    my scalar $exit_sym2 = core::dl_sym($lib, "cannoli_worker_exit");
                    if (defined($exit_sym2)) { push(@{$_g_exit_funcs}, $exit_sym2); }
                    my scalar $tick_sym2 = core::dl_sym($lib, "cannoli_tick");
                    if (defined($tick_sym2)) { push(@{$_g_tick_funcs}, $tick_sym2); say("    Loaded: cannoli_tick"); }
                    push(@{$server{"library_routes"}}, \%lib_route);
                    say("    Loaded: cannoli_dispatch");
                    if (defined($lib_route{"after"})) {
                        say("    Loaded: cannoli_after_request");
                    }
                } else {
                    say("    Warning: cannoli_dispatch not found");
                }
            } else {
                say("    Error: Could not load library");
            }
            $j = $j + 1;
        }
        say("");
    }

    return \%server;
}

# Set the router for the server
func Cannoli_Server_set_router(scalar $server_ref, scalar $router) void {
    $server_ref->{"router"} = $router;
}

# Create the SSL listening socket
func Cannoli_Server_create_ssl_socket(scalar $server_ref) scalar {
    my int $ssl_port = $server_ref->{"ssl_port"};
    my str $cert = $server_ref->{"ssl_cert"};
    my str $key = $server_ref->{"ssl_key"};
    my scalar $ssl_server_fn = $server_ref->{"ssl_server_fn"};


    if (!defined($ssl_server_fn)) {
        say("Error: SSL library not loaded");
        return undef;
    }

    if (length($cert) == 0 || length($key) == 0) {
        say("Error: SSL cert and key paths required");
        return undef;
    }

    # Bind the configured host (IPv4/IPv6/dual-stack) when the host-aware TLS
    # entry point is available; otherwise fall back to the wildcard listener.
    my str $host = $server_ref->{"host"};
    my scalar $ssl_server_host_fn = $server_ref->{"ssl_server_host_fn"};
    my scalar $ssl_server = undef;
    if (defined($ssl_server_host_fn)) {
        $ssl_server = core::dl_call_sv($ssl_server_host_fn, [$host, $ssl_port, $cert, $key]);
    } else {
        $ssl_server = core::dl_call_sv($ssl_server_fn, [$ssl_port, $cert, $key]);
    }

    if (!defined($ssl_server)) {
        say("Error: Could not create SSL server on port " . $ssl_port);
        return undef;
    }

    $server_ref->{"ssl_server"} = $ssl_server;
    say("SSL listening on " . $server_ref->{"host"} . ":" . $ssl_port);

    return $ssl_server;
}

# Create the listening socket
func Cannoli_Server_create_socket(scalar $server_ref) scalar {
    my str $host = $server_ref->{"host"};
    my int $port = $server_ref->{"port"};
    my int $backlog = $server_ref->{"backlog"};

    # Bind the configured host (IPv4 or IPv6). "" / "*" / "::" mean the
    # dual-stack wildcard (accepts both IPv4 and IPv6); "0.0.0.0" is IPv4-only;
    # a literal like "::1" / "127.0.0.1" binds that address only.
    my scalar $server_sock = core::socket_server_host($host, $port, $backlog);

    if (!defined($server_sock)) {
        say("Error: Could not create server socket on port " . $port);
        return undef;
    }

    # Set non-blocking to prevent thundering herd problem with multiple workers
    # When select() wakes all workers, only one will get the connection;
    # others will get EAGAIN from accept() instead of blocking
    core::socket_set_nonblocking($server_sock, 1);

    $server_ref->{"server_sock"} = $server_sock;
    say("Listening on " . $host . ":" . $port . " (backlog=" . $backlog . ")");

    return $server_sock;
}

# Serialize request headers hash to string format: "name:value\nname:value\n..."
func Cannoli_Server_serialize_headers(scalar $headers_ref) str {
    my str $result = "";
    my array @keys = keys(%{$headers_ref});
    my int $i = 0;
    while ($i < scalar(@keys)) {
        my str $name = $keys[$i];
        my str $value = $headers_ref->{$name};
        $result = $result . $name . ":" . $value . "\n";
        $i = $i + 1;
    }
    return $result;
}

# Parse a response body from a library into a response hash
# Supports special prefixes:
#   STATUS:xxx:content - custom status code
#   REDIRECT:url - redirect response
#   RESPONSE:status:headers_len:headers:body - full response with headers
# Auto-detects JSON (starts with { or [) and HTML (starts with <)
func Cannoli_Server_parse_response(str $response_body) hash {
    my hash %res = ();

    if (substr($response_body, 0, 9) eq "RESPONSE:") {
        # RESPONSE:status:headers_len:headers:body - full response with custom headers
        my str $rest = core::byte_substr($response_body, 9, core::byte_length($response_body) - 9);
        my int $colon1 = index($rest, ":");
        if ($colon1 > 0) {
            my str $status_str = substr($rest, 0, $colon1);
            my int $status = $status_str + 0;

            $rest = core::byte_substr($rest, $colon1 + 1, core::byte_length($rest) - $colon1 - 1);
            my int $colon2 = index($rest, ":");
            if ($colon2 > 0) {
                my str $headers_len_str = substr($rest, 0, $colon2);
                my int $headers_len = $headers_len_str + 0;

                $rest = core::byte_substr($rest, $colon2 + 1, core::byte_length($rest) - $colon2 - 1);
                my int $rest_len = core::byte_length($rest);
                if ($headers_len >= 0 && $rest_len >= $headers_len + 1 && core::byte_substr($rest, $headers_len, 1) eq ":") {
                    my str $headers_str = core::byte_substr($rest, 0, $headers_len);
                    my str $content = core::byte_substr($rest, $headers_len + 1, $rest_len - $headers_len - 1);

                    # Start with text response, then override headers via validated helper
                    %res = Cannoli::Response::text($status, $content);

                    # Parse and apply custom headers (Content-Type:value\nHeader:value...)
                    my array @header_lines = split("\n", $headers_str);
                    my int $j = 0;
                    while ($j < scalar(@header_lines)) {
                        my str $line = $header_lines[$j];
                        if (length($line) > 0 && substr($line, length($line) - 1, 1) eq "\r") {
                            $line = substr($line, 0, length($line) - 1);
                        }
                        my int $colon = index($line, ":");
                        if ($colon > 0) {
                            my str $name = trim(substr($line, 0, $colon));
                            my str $value = trim(substr($line, $colon + 1, length($line) - $colon - 1));
                            Cannoli::Response::header(%res, $name, $value);
                        }
                        $j = $j + 1;
                    }
                } else {
                    %res = Cannoli::Response::text(200, $response_body);
                }
            } else {
                %res = Cannoli::Response::text(200, $response_body);
            }
        } else {
            %res = Cannoli::Response::text(200, $response_body);
        }
    } elsif (substr($response_body, 0, 7) eq "STATUS:") {
        # STATUS:xxx:content - custom status code
        my int $colon1 = 7;
        my int $colon2 = index($response_body, ":", $colon1);
        if ($colon2 > $colon1) {
            my str $status_str = substr($response_body, $colon1, $colon2 - $colon1);
            my int $status = $status_str + 0;
            my str $content = substr($response_body, $colon2 + 1, length($response_body) - $colon2 - 1);
            %res = Cannoli::Response::text($status, $content);
        } else {
            %res = Cannoli::Response::text(200, $response_body);
        }
    } elsif (substr($response_body, 0, 9) eq "REDIRECT:") {
        # REDIRECT:url - redirect response
        my str $url = substr($response_body, 9, length($response_body) - 9);
        %res = Cannoli::Response::redirect($url, 0);
    } elsif (substr($response_body, 0, 1) eq "{" || substr($response_body, 0, 1) eq "[") {
        # JSON response
        %res = Cannoli::Response::json(200, $response_body);
    } elsif (substr($response_body, 0, 1) eq "<") {
        # HTML response
        %res = Cannoli::Response::html(200, $response_body);
    } else {
        # Plain text
        %res = Cannoli::Response::text(200, $response_body);
    }

    return %res;
}

# ===========================================================================
# Connection layer
#
# Plain TCP and TLS connections share one code path. A connection is a hash
#   { tls, sock (plain), ssl (TLS handle), fd, nb (TLS non-blocking API),
#     peer, requests, timed_out }
# and every read and write is bounded by a deadline, so a slow or silent
# client can never pin a worker (slowloris on headers or body, a client that
# never reads its response, a TLS client that never finishes the handshake).
# In loop-worker mode the waits park the green task; in classic workers they
# poll() the client fd.
# ===========================================================================

# Wait until $fd is ready for $mask ("r" or "w") or $timeout_ms passes.
func Cannoli_Server_wait_fd(int $fd, str $mask, int $timeout_ms) void {
    if ($timeout_ms < 1) { $timeout_ms = 1; }
    my int $r = core::coro_yield_io($fd, $mask, $timeout_ms);
    if ($r <= 0) {
        # not inside a green task (or the task cannot park here): poll()
        my scalar $p = {"fd" => $fd, "events" => ($mask eq "w" ? 4 : 1)};
        core::poll([$p], $timeout_ms);
    }
}

func Cannoli_Server_plain_conn(scalar $client) scalar {
    my scalar $conn = {"tls" => 0, "sock" => $client, "ssl" => undef, "nb" => 1,
                       "fd" => core::socket_fd($client), "requests" => 0, "timed_out" => 0};
    my scalar $peer = core::getpeername($conn->{"fd"});
    $conn->{"peer"} = defined($peer) ? $peer->{"addr"} : "";
    return $conn;
}

func Cannoli_Server_tls_conn(scalar $server_ref, scalar $ssl_conn) scalar {
    my int $fd = -1;
    if (defined($server_ref->{"ssl_fd_fn"})) {
        $fd = core::dl_call_int_sv($server_ref->{"ssl_fd_fn"}, [$ssl_conn]);
    }
    my int $nb = (defined($server_ref->{"ssl_try_read_fn"}) && defined($server_ref->{"ssl_try_write_fn"})
                  && defined($server_ref->{"ssl_want_fn"}) && $fd >= 0) ? 1 : 0;
    my scalar $conn = {"tls" => 1, "sock" => undef, "ssl" => $ssl_conn, "nb" => $nb,
                       "fd" => $fd, "requests" => 0, "timed_out" => 0, "peer" => ""};
    if ($fd >= 0) {
        my scalar $peer = core::getpeername($fd);
        if (defined($peer)) { $conn->{"peer"} = $peer->{"addr"}; }
    }
    return $conn;
}

# Receive up to 64KB, waiting no later than $deadline (core::mono_ms). Returns
# "" on EOF, error or timeout; a timeout also sets $conn->{"timed_out"}.
func Cannoli_Server_conn_recv(scalar $server_ref, scalar $conn, int $deadline) str {
    $conn->{"timed_out"} = 0;
    if ($conn->{"tls"} == 0) {
        my int $left = $deadline - core::mono_ms();
        if ($left <= 0) { $conn->{"timed_out"} = 1; return ""; }
        my scalar $data = Async::Task::recv($conn->{"sock"}, 65536, $left);
        if (!defined($data)) { $conn->{"timed_out"} = 1; return ""; }
        return $data;
    }
    if ($conn->{"nb"} == 0) {
        # SSL library without the non-blocking entry points: blocking read
        my scalar $old = core::dl_call_str_sv($server_ref->{"ssl_read_fn"}, [$conn->{"ssl"}, 65536]);
        return defined($old) ? $old : "";
    }
    while (1) {
        my scalar $chunk = core::dl_call_sv($server_ref->{"ssl_try_read_fn"}, [$conn->{"ssl"}, 65536]);
        if (defined($chunk)) { return $chunk; }
        my int $left = $deadline - core::mono_ms();
        if ($left <= 0) { $conn->{"timed_out"} = 1; return ""; }
        my int $want = core::dl_call_int_sv($server_ref->{"ssl_want_fn"}, [$conn->{"ssl"}]);
        ::wait_fd($conn->{"fd"}, $want == 2 ? "w" : "r", $left);
    }
    return "";
}

# Send all of $data. Fails (returns 0) when the peer is gone or makes no
# progress for server.write_timeout seconds; returns 1 on success.
func Cannoli_Server_conn_send(scalar $server_ref, scalar $conn, str $data) int {
    my int $total = core::byte_length($data);
    if ($total == 0) { return 1; }
    my int $idle_ms = $server_ref->{"write_timeout"} * 1000;

    if ($conn->{"tls"} == 1 && $conn->{"nb"} == 0) {
        my int $n = core::dl_call_int_sv($server_ref->{"ssl_write_fn"}, [$conn->{"ssl"}, $data]);
        return $n > 0 ? 1 : 0;
    }

    my int $sent = 0;
    my int $deadline = core::mono_ms() + $idle_ms;
    while ($sent < $total) {
        # Bounded slices keep each copy small for multi-megabyte bodies. A
        # TLS retry after WANT must reuse the same buffer, so $slice is only
        # rebuilt after progress.
        my int $len = $total - $sent;
        if ($len > 262144) { $len = 262144; }
        my str $slice = ($sent == 0 && $len == $total) ? $data : core::byte_substr($data, $sent, $len);
        my int $done = 0;
        while ($done == 0) {
            my int $n = 0;
            if ($conn->{"tls"} == 1) {
                $n = core::dl_call_int_sv($server_ref->{"ssl_try_write_fn"}, [$conn->{"ssl"}, $slice]);
            } else {
                $n = core::socket_try_send($conn->{"sock"}, $slice);
            }
            if ($n < 0) { return 0; }
            if ($n > 0) {
                $sent = $sent + $n;
                $deadline = core::mono_ms() + $idle_ms;
                if ($n < $len) {
                    $len = $len - $n;
                    $slice = core::byte_substr($slice, $n, $len);
                    next;
                }
                $done = 1;
                next;
            }
            my int $left = $deadline - core::mono_ms();
            if ($left <= 0) { return 0; }
            my str $mask = "w";
            if ($conn->{"tls"} == 1 && core::dl_call_int_sv($server_ref->{"ssl_want_fn"}, [$conn->{"ssl"}]) == 1) {
                $mask = "r";
            }
            ::wait_fd($conn->{"fd"}, $mask, $left);
        }
    }
    return 1;
}

func Cannoli_Server_conn_close(scalar $server_ref, scalar $conn) void {
    if ($conn->{"tls"} == 1) {
        core::dl_call_void_sv($server_ref->{"ssl_close_fn"}, [$conn->{"ssl"}]);
    } else {
        core::socket_close($conn->{"sock"});
    }
}

# Close after an error response that was sent before the request was fully
# read. Closing a socket with unread input makes the kernel send RST, which
# can destroy the response before the client reads it; so half-close, then
# discard what the client is still sending (bounded: 1s / 256KB) first.
func Cannoli_Server_conn_linger_close(scalar $server_ref, scalar $conn) void {
    if ($conn->{"tls"} == 0) {
        core::shutdown($conn->{"sock"}, 1);   # SHUT_WR: FIN after the response
    }
    if ($conn->{"tls"} == 0 || $conn->{"nb"} == 1) {
        my int $deadline = core::mono_ms() + 1000;
        my int $drained = 0;
        while ($drained < 262144) {
            my str $junk = ::conn_recv($server_ref, $conn, $deadline);
            if (core::byte_length($junk) == 0) { last; }
            $drained = $drained + core::byte_length($junk);
        }
    }
    ::conn_close($server_ref, $conn);
}

# Accept one TLS connection and complete its handshake within
# server.header_timeout. Returns a conn hash or undef. Uses the non-blocking
# entry points when the SSL library has them (so a client that connects and
# never speaks cannot pin a classic worker); otherwise the old blocking accept.
func Cannoli_Server_accept_tls(scalar $server_ref, scalar $ssl_server) scalar {
    if (!defined($server_ref->{"ssl_try_accept_fn"}) || !defined($server_ref->{"ssl_handshake_step_fn"})) {
        my scalar $old = core::dl_call_sv($server_ref->{"ssl_accept_fn"}, [$ssl_server]);
        if (!defined($old) || $old == 0) { return undef; }
        return ::tls_conn($server_ref, $old);
    }
    my scalar $ssl_conn = core::dl_call_sv($server_ref->{"ssl_try_accept_fn"}, [$ssl_server]);
    if (!defined($ssl_conn) || $ssl_conn == 0) { return undef; }   # another worker took it
    my int $cfd = core::dl_call_int_sv($server_ref->{"ssl_fd_fn"}, [$ssl_conn]);
    # A client that has not even sent its ClientHello gets the same short
    # idle allowance as a plain connection; the handshake as a whole is
    # bounded by header_timeout.
    if ($server_ref->{"loop_mode"} != 1) {
        my scalar $p = {"fd" => $cfd, "events" => 1};
        if (core::poll([$p], $server_ref->{"keep_alive_timeout"} * 1000) <= 0) {
            core::dl_call_void_sv($server_ref->{"ssl_close_fn"}, [$ssl_conn]);
            return undef;
        }
    }
    my int $deadline = core::mono_ms() + $server_ref->{"header_timeout"} * 1000;
    while (1) {
        my int $st = core::dl_call_int_sv($server_ref->{"ssl_handshake_step_fn"}, [$ssl_conn]);
        if ($st == 0) { return ::tls_conn($server_ref, $ssl_conn); }
        my int $left = $deadline - core::mono_ms();
        if ($st < 0 || $left <= 0) { last; }
        ::wait_fd($cfd, $st == 2 ? "w" : "r", $left);
    }
    core::dl_call_void_sv($server_ref->{"ssl_close_fn"}, [$ssl_conn]);
    return undef;
}

# ===========================================================================
# Request framing (RFC 9112)
# ===========================================================================

# Build an error result for read_request
func Cannoli_Server_read_error(str $code, int $limit) scalar {
    my hash %result = ();
    $result{"error"} = $code;
    $result{"limit"} = $limit;
    return \%result;
}

# Check a decimal Content-Length value without relying on numeric coercion.
func Cannoli_Server_is_decimal(str $value) int {
    if (length($value) == 0) { return 0; }

    my int $i = 0;
    while ($i < length($value)) {
        my str $ch = substr($value, $i, 1);
        if ($ch lt "0" || $ch gt "9") { return 0; }
        $i = $i + 1;
    }

    return 1;
}

# RFC 9110 token (header field names, methods).
func Cannoli_Server_is_token(str $s) int {
    return ($s =~ /^[-!#\$%&'*+.^_`|~0-9A-Za-z]+$/) ? 1 : 0;
}

# Trim only SP and HTAB (optional whitespace around a field value).
func Cannoli_Server_trim_ows(str $s) str {
    my int $start = 0;
    my int $end = length($s);
    while ($start < $end) {
        my str $ch = substr($s, $start, 1);
        if ($ch ne " " && $ch ne "\t") { last; }
        $start = $start + 1;
    }
    while ($end > $start) {
        my str $ch = substr($s, $end - 1, 1);
        if ($ch ne " " && $ch ne "\t") { last; }
        $end = $end - 1;
    }
    return substr($s, $start, $end - $start);
}

# Parse and validate a request header block (request line + fields, no final
# CRLFCRLF). Returns {ok => 0} for anything a strict HTTP/1.1 server must
# reject -- the inputs request smuggling depends on: bare CR or LF, obsolete
# line folding, whitespace before the colon, non-token field names, control
# bytes in values, duplicate/conflicting Content-Length, unsupported or
# repeated Transfer-Encoding, TE together with CL, duplicate Host, and a
# missing Host on HTTP/1.1. Otherwise ok => 1 plus te (0/1), cl, has_cl,
# expect, version.
func Cannoli_Server_parse_head(str $header_section) scalar {
    my scalar $out = {"ok" => 0, "te" => 0, "cl" => 0, "has_cl" => 0, "expect" => "", "version" => ""};
    if (::valid_request_line($header_section) == 0) { return $out; }

    my array @lines = split("\r\n", $header_section);
    # valid_request_line guarantees the line ends in exactly "HTTP/1.x"
    $out->{"version"} = substr($lines[0], length($lines[0]) - 8, 8);

    my int $hosts = 0;
    my int $i = 1;
    my int $n = scalar(@lines);
    while ($i < $n) {
        my str $line = $lines[$i];
        if (length($line) == 0) { return $out; }
        my str $first = substr($line, 0, 1);
        if ($first eq " " || $first eq "\t") { return $out; }   # obs-fold
        my int $colon = index($line, ":");
        if ($colon <= 0) { return $out; }
        my str $name = substr($line, 0, $colon);
        if (::is_token($name) == 0) { return $out; }
        my str $raw = substr($line, $colon + 1, length($line) - $colon - 1);
        # field-value: no CR, LF, NUL or other C0 controls except HTAB
        if ($raw =~ /[\x00-\x08\x0a-\x1f\x7f]/) { return $out; }
        my str $value = ::trim_ows($raw);
        my str $lname = lc($name);

        if ($lname eq "content-length") {
            if (::is_decimal($value) == 0) { return $out; }
            my int $parsed = 0;
            my int $d = 0;
            while ($d < length($value)) {
                my int $digit = ord(substr($value, $d, 1)) - 48;
                if ($parsed > (9223372036854775807 - $digit) / 10) { return $out; }
                $parsed = $parsed * 10 + $digit;
                $d = $d + 1;
            }
            if ($out->{"has_cl"} == 1 && $parsed != $out->{"cl"}) { return $out; }
            $out->{"has_cl"} = 1;
            $out->{"cl"} = $parsed;
        } elsif ($lname eq "transfer-encoding") {
            if ($out->{"te"} == 1) { return $out; }
            if (lc($value) ne "chunked") { return $out; }
            $out->{"te"} = 1;
        } elsif ($lname eq "host") {
            $hosts = $hosts + 1;
            if ($hosts > 1) { return $out; }
        } elsif ($lname eq "expect") {
            $out->{"expect"} = lc($value);
        }
        $i = $i + 1;
    }

    if ($out->{"te"} == 1 && $out->{"has_cl"} == 1) { return $out; }
    if ($out->{"version"} eq "HTTP/1.1" && $hosts == 0) { return $out; }
    $out->{"ok"} = 1;
    return $out;
}

# Compatibility wrappers (used by tests and older callers).
# Return 0 for no Transfer-Encoding, 1 for exactly "chunked", and -1 for
# duplicate or unsupported codings.
func Cannoli_Server_parse_transfer_encoding(str $header_section) int {
    my array @lines = split("\r\n", $header_section);
    my int $i = 1;  # skip request line
    my int $seen = 0;
    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];
        my int $colon = index($line, ":");
        if ($colon > 0 && lc(substr($line, 0, $colon)) eq "transfer-encoding") {
            if ($seen == 1) { return -1; }
            $seen = 1;
            my str $value = lc(::trim_ows(substr($line, $colon + 1, length($line) - $colon - 1)));
            if ($value ne "chunked") { return -1; }
        }
        $i = $i + 1;
    }
    return $seen;
}

func Cannoli_Server_has_transfer_encoding(str $header_section) int {
    return ::parse_transfer_encoding($header_section) != 0;
}

func Cannoli_Server_has_content_length(str $header_section) int {
    my array @lines = split("\r\n", $header_section);
    my int $i = 1;
    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];
        my int $colon = index($line, ":");
        if ($colon > 0 && lc(substr($line, 0, $colon)) eq "content-length") { return 1; }
        $i = $i + 1;
    }
    return 0;
}

# Parse Content-Length from request headers. Returns -1 for malformed or
# conflicting values, and 0 if missing.
func Cannoli_Server_parse_content_length(str $header_section) int {
    my array @lines = split("\r\n", $header_section);
    my int $i = 1;  # skip request line
    my int $seen = 0;
    my int $content_len = 0;
    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];
        my int $colon = index($line, ":");
        if ($colon > 0 && lc(substr($line, 0, $colon)) eq "content-length") {
            my str $value = ::trim_ows(substr($line, $colon + 1, length($line) - $colon - 1));
            if (::is_decimal($value) == 0) { return -1; }
            # Guard against 64-bit signed integer overflow
            my int $parsed = 0;
            my int $d = 0;
            while ($d < length($value)) {
                my int $digit = ord(substr($value, $d, 1)) - 48;
                if ($parsed > (9223372036854775807 - $digit) / 10) { return -1; }
                $parsed = $parsed * 10 + $digit;
                $d = $d + 1;
            }
            if ($seen == 1 && $parsed != $content_len) { return -1; }
            $seen = 1;
            $content_len = $parsed;
        }
        $i = $i + 1;
    }
    return $content_len;
}

func Cannoli_Server_hex_digit(str $ch) int {
    my int $n = ord($ch);
    if ($n >= 48 && $n <= 57) { return $n - 48; }
    if ($n >= 65 && $n <= 70) { return $n - 55; }
    if ($n >= 97 && $n <= 102) { return $n - 87; }
    return -1;
}

# Validate an HTTP/1.x request line: METHOD SP request-target SP HTTP/1.x,
# exactly one space between the parts, a token method, and a target with no
# controls or spaces in origin-, absolute- or asterisk-form.
func Cannoli_Server_valid_request_line(str $header_section) int {
    my int $eol = index($header_section, "\r\n");
    my str $req_line = ($eol >= 0) ? substr($header_section, 0, $eol) : $header_section;
    my int $sp1 = index($req_line, " ");
    if ($sp1 <= 0) { return 0; }
    my int $sp2 = index($req_line, " ", $sp1 + 1);
    if ($sp2 <= $sp1 + 1) { return 0; }
    if (index($req_line, " ", $sp2 + 1) >= 0) { return 0; }

    my str $method = substr($req_line, 0, $sp1);
    my str $target = substr($req_line, $sp1 + 1, $sp2 - $sp1 - 1);
    my str $version = substr($req_line, $sp2 + 1, length($req_line) - $sp2 - 1);

    if ($version ne "HTTP/1.1" && $version ne "HTTP/1.0") { return 0; }
    if (::is_token($method) == 0) { return 0; }

    if ($target =~ /[\x00-\x20\x7f]/) { return 0; }
    my str $t0 = substr($target, 0, 1);
    if ($t0 eq "*") { return $target eq "*" ? 1 : 0; }
    if ($t0 ne "/" && lc(substr($target, 0, 7)) ne "http://" && lc(substr($target, 0, 8)) ne "https://") {
        return 0;
    }

    return 1;
}

# Rewrite an absolute-form request line ("GET http://host/path HTTP/1.1") to
# origin-form so routing sees "/path".
func Cannoli_Server_origin_form(str $header_section) str {
    my int $sp1 = index($header_section, " ");
    my int $sp2 = index($header_section, " ", $sp1 + 1);
    my str $target = substr($header_section, $sp1 + 1, $sp2 - $sp1 - 1);
    my int $scheme_end = index($target, "://");
    if (substr($target, 0, 1) eq "/" || $scheme_end < 0) { return $header_section; }
    my int $path_start = index($target, "/", $scheme_end + 3);
    my str $path = "/";
    if ($path_start >= 0) {
        $path = substr($target, $path_start, length($target) - $path_start);
    } else {
        my int $q = index($target, "?", $scheme_end + 3);
        if ($q >= 0) { $path = "/" . substr($target, $q, length($target) - $q); }
    }
    return substr($header_section, 0, $sp1 + 1) . $path
        . substr($header_section, $sp2, length($header_section) - $sp2);
}

# Incremental chunked-body decoder. $state persists across calls for one
# request: {status, pos (offset into $data), body, size (bytes left in the
# current chunk, -1 = expecting a size line)}. Each call resumes where the
# last one stopped, so the cost is linear in the body however it arrives.
# status: need_more, ok, bad, or too_large; on ok, consumed is the offset
# just past the body (pipelined bytes start there).
func Cannoli_Server_chunked_state() scalar {
    return {"status" => "need_more", "pos" => 0, "body" => "", "size" => -1, "consumed" => 0};
}

func Cannoli_Server_decode_chunked_step(str $data, scalar $st, int $max_body, int $max_trailers) void {
    my int $data_len = core::byte_length($data);
    my int $pos = $st->{"pos"};
    while (1) {
        if ($st->{"size"} > 0 || $st->{"size"} == -2) {
            # inside chunk data (size > 0), or awaiting the CRLF after it (-2)
            if ($st->{"size"} > 0) {
                my int $avail = $data_len - $pos;
                if ($avail <= 0) { $st->{"pos"} = $pos; return; }
                my int $take = $st->{"size"};
                if ($take > $avail) { $take = $avail; }
                $st->{"body"} = $st->{"body"} . core::byte_substr($data, $pos, $take);
                $pos = $pos + $take;
                $st->{"size"} = $st->{"size"} - $take;
                if ($st->{"size"} > 0) { $st->{"pos"} = $pos; return; }
                $st->{"size"} = -2;
            }
            if ($data_len - $pos < 2) { $st->{"pos"} = $pos; return; }
            if (core::byte_substr($data, $pos, 2) ne "\r\n") { $st->{"status"} = "bad"; return; }
            $pos = $pos + 2;
            $st->{"size"} = -1;
            next;
        }

        # chunk-size [ chunk-ext ] CRLF
        my int $line_start = $pos;
        my int $line_end = index($data, "\r\n", $pos);
        if ($line_end < 0) {
            if ($data_len - $pos > 1024) { $st->{"status"} = "bad"; }
            $st->{"pos"} = $pos;
            return;
        }
        if ($line_end - $pos > 1024 || $line_end == $pos) { $st->{"status"} = "bad"; return; }
        my str $line = core::byte_substr($data, $pos, $line_end - $pos);
        my int $ll = length($line);
        my int $chunk_size = 0;
        my int $i = 0;
        while ($i < $ll) {
            my int $digit = ::hex_digit(substr($line, $i, 1));
            if ($digit < 0) { last; }
            if ($max_body >= 0 && $chunk_size > ($max_body - $digit) / 16) {
                $st->{"status"} = "too_large";
                return;
            }
            $chunk_size = $chunk_size * 16 + $digit;
            $i = $i + 1;
        }
        if ($i == 0) { $st->{"status"} = "bad"; return; }
        if ($i < $ll) {
            # chunk-ext = *( BWS ";" ... ): only SP/HTAB may precede ';', and
            # the extension may not carry controls (a bare LF here is the
            # chunk-extension smuggling vector).
            while ($i < $ll && (substr($line, $i, 1) eq " " || substr($line, $i, 1) eq "\t")) { $i = $i + 1; }
            if ($i >= $ll || substr($line, $i, 1) ne ";") { $st->{"status"} = "bad"; return; }
            while ($i < $ll) {
                my int $c = ord(substr($line, $i, 1));
                if (($c < 32 && $c != 9) || $c == 127) { $st->{"status"} = "bad"; return; }
                $i = $i + 1;
            }
        }
        $pos = $line_end + 2;

        if ($chunk_size == 0) {
            # last-chunk, then the trailer section, then CRLF. Until all of it
            # has arrived, resume from the start of this size line.
            if ($data_len < $pos + 2) {
                $st->{"pos"} = $line_start;
                return;
            }
            if (core::byte_substr($data, $pos, 2) eq "\r\n") {
                $pos = $pos + 2;
            } else {
                my int $trailers_end = index($data, "\r\n\r\n", $pos);
                if ($trailers_end < 0) {
                    if ($data_len - $pos > $max_trailers) { $st->{"status"} = "bad"; return; }
                    $st->{"pos"} = $line_start;
                    return;
                }
                if ($trailers_end - $pos > $max_trailers) { $st->{"status"} = "bad"; return; }
                # trailer fields: same rules as header fields (no bare CR/LF)
                my str $trailers = core::byte_substr($data, $pos, $trailers_end - $pos);
                foreach my str $tline (split("\r\n", $trailers)) {
                    if (index($tline, "\r") >= 0 || index($tline, "\n") >= 0 || index($tline, ":") <= 0) {
                        $st->{"status"} = "bad";
                        return;
                    }
                }
                $pos = $trailers_end + 4;
            }
            $st->{"status"} = "ok";
            $st->{"consumed"} = $pos;
            $st->{"pos"} = $pos;
            return;
        }

        if ($max_body >= 0 && core::byte_length($st->{"body"}) > $max_body - $chunk_size) {
            $st->{"status"} = "too_large";
            return;
        }
        $st->{"size"} = $chunk_size;
    }
}

# One-shot decode (compatibility; used by tests).
func Cannoli_Server_decode_chunked(str $data, int $max_body, int $max_trailers) scalar {
    my scalar $st = ::chunked_state();
    ::decode_chunked_step($data, $st, $max_body, $max_trailers);
    my hash %out = {"status" => $st->{"status"}, "body" => "", "consumed" => 0};
    if ($st->{"status"} eq "ok") {
        $out{"body"} = $st->{"body"};
        $out{"consumed"} = $st->{"consumed"};
    }
    return \%out;
}

# Decide if the connection should be kept alive
func Cannoli_Server_should_keep_alive(scalar $server_ref, hash %req) int {
    if ($server_ref->{"keep_alive_enabled"} != 1) {
        return 0;
    }
    if (exists(%req, "_force_close") && $req{"_force_close"} == 1) {
        return 0;
    }

    # Drain cleanly when worker retirement/shutdown has been requested or
    # when a classic worker has reached its max_requests quota.
    if ($_g_exit_requested == 1) {
        return 0;
    }
    if ($server_ref->{"loop_mode"} != 1 && $server_ref->{"max_requests"} > 0
        && ($_g_worker_requests + 1) >= $server_ref->{"max_requests"}) {
        return 0;
    }

    # In single-process dev mode, one idle keep-alive socket can block all new
    # accepts. Force close so each request yields back to the accept loop.
    if ($server_ref->{"single_process"} == 1) {
        return 0;
    }

    my str $version = $req{"http_version"};
    my str $conn = lc(Cannoli::Request::get_header(%req, "Connection"));

    if ($version eq "HTTP/1.1") {
        if (index($conn, "close") >= 0) {
            return 0;
        }
        return 1;
    }

    if ($version eq "HTTP/1.0") {
        if (index($conn, "keep-alive") >= 0) {
            return 1;
        }
        return 0;
    }

    return 0;
}

# Deadline for the next body read: server.timeout of silence at most, and
# overall no slower than server.body_min_rate bytes/s after a grace period
# of server.timeout (so a client trickling a body cannot hold a worker).
func Cannoli_Server_body_deadline(scalar $server_ref, int $body_start, int $received) int {
    my int $timeout_ms = $server_ref->{"timeout"} * 1000;
    my int $deadline = core::mono_ms() + $timeout_ms;
    my int $rate = $server_ref->{"body_min_rate"};
    if ($rate > 0) {
        my int $total = $body_start + $timeout_ms + ($received * 1000) / $rate;
        if ($total < $deadline) { $deadline = $total; }
    }
    return $deadline;
}

# Read and frame one request from $conn. $buffer holds bytes already read
# (pipelining). Returns {req, buffer}, {error, limit}, or undef when the
# connection should just be closed (EOF or idle keep-alive timeout).
func Cannoli_Server_read_request(scalar $server_ref, scalar $conn, str $buffer) scalar {
    my int $max_header = $server_ref->{"max_header_size"};
    my int $max_body = $server_ref->{"max_body_size"};

    # Wait for the first byte. In a classic worker an idle connection (fresh
    # or kept alive) pins the whole process, so it gets only
    # keep_alive_timeout -- short, so the worker returns to accept()
    # promptly (browser preconnects open sockets they may never use). Loop
    # workers park a cheap task, so a fresh connection gets header_timeout.
    if (core::byte_length($buffer) == 0) {
        my int $idle_s = $server_ref->{"keep_alive_timeout"};
        if ($server_ref->{"loop_mode"} == 1 && $conn->{"requests"} == 0) { $idle_s = $server_ref->{"header_timeout"}; }
        my str $first = ::conn_recv($server_ref, $conn, core::mono_ms() + $idle_s * 1000);
        if (core::byte_length($first) == 0) { return undef; }
        $buffer = $first;
    }

    # The whole header block must arrive within header_timeout of its first byte.
    my int $header_deadline = core::mono_ms() + $server_ref->{"header_timeout"} * 1000;

    # RFC 9112 2.2: ignore empty lines before the request line.
    while (substr($buffer, 0, 2) eq "\r\n") {
        $buffer = core::byte_substr($buffer, 2, core::byte_length($buffer) - 2);
        if (core::byte_length($buffer) == 0) {
            my str $more = ::conn_recv($server_ref, $conn, $header_deadline);
            if (core::byte_length($more) == 0) { return undef; }
            $buffer = $more;
        }
    }

    my int $header_end = index($buffer, "\r\n\r\n");
    while ($header_end < 0) {
        if (core::byte_length($buffer) > $max_header) {
            return ::read_error("header_too_large", $max_header);
        }
        my str $chunk = ::conn_recv($server_ref, $conn, $header_deadline);
        if (core::byte_length($chunk) == 0) {
            if ($conn->{"timed_out"} == 1) { return ::read_error("timeout", 0); }
            return undef;
        }
        # only rescan the tail: the terminator may straddle the old end
        my int $scan_from = core::byte_length($buffer) - 3;
        if ($scan_from < 0) { $scan_from = 0; }
        $buffer = $buffer . $chunk;
        $header_end = index($buffer, "\r\n\r\n", $scan_from);
    }

    if ($header_end > $max_header) {
        return ::read_error("header_too_large", $max_header);
    }

    my str $header_section = core::byte_substr($buffer, 0, $header_end);
    my scalar $head = ::parse_head($header_section);
    if ($head->{"ok"} != 1) {
        return ::read_error("bad_request", 0);
    }
    $header_section = ::origin_form($header_section);

    my int $transfer = $head->{"te"};
    my int $content_len = $head->{"cl"};
    if ($content_len > $max_body) {
        return ::read_error("body_too_large", $max_body);
    }

    # Expect: 100-continue -- tell the client to send the body (it would
    # otherwise stall ~1s, as curl does for bodies over 1KB). Any other
    # expectation is unsupported (RFC 9110 10.1.1).
    my str $expect = $head->{"expect"};
    my int $body_have = core::byte_length($buffer) - $header_end - 4;
    if (length($expect) > 0) {
        if ($expect ne "100-continue") {
            return ::read_error("expectation_failed", 0);
        }
        if ($head->{"version"} eq "HTTP/1.1" && ($transfer == 1 || $content_len > 0) && $body_have == 0) {
            if (::conn_send($server_ref, $conn, "HTTP/1.1 100 Continue\r\n\r\n") == 0) { return undef; }
        }
    }

    my int $body_start = core::mono_ms();
    my int $body_offset = $header_end + 4;

    if ($transfer == 1) {
        my scalar $st = ::chunked_state();
        $st->{"pos"} = $body_offset;
        while (1) {
            ::decode_chunked_step($buffer, $st, $max_body, $max_header);
            if ($st->{"status"} eq "ok") {
                my int $used = $st->{"consumed"};
                my int $buf_len = core::byte_length($buffer);
                my str $dec_body = $st->{"body"};
                my hash %chunked_req = Cannoli::Request::parse($header_section . "\r\n\r\n" . $dec_body);
                # The application sees a plain fixed-length request.
                my scalar $hdrs = $chunked_req{"headers"};
                if (defined($hdrs)) {
                    delete($hdrs->{"transfer-encoding"});
                    $hdrs->{"content-length"} = "" . core::byte_length($dec_body);
                }
                $chunked_req{"content_length"} = "" . core::byte_length($dec_body);
                # RFC 9112 6.1: chunked on an HTTP/1.0 request -> close after.
                if ($head->{"version"} eq "HTTP/1.0") { $chunked_req{"_force_close"} = 1; }
                my hash %chunked_result = {"req" => \%chunked_req, "buffer" => core::byte_substr($buffer, $used, $buf_len - $used)};
                return \%chunked_result;
            }
            if ($st->{"status"} eq "bad") { return ::read_error("bad_request", 0); }
            if ($st->{"status"} eq "too_large") { return ::read_error("body_too_large", $max_body); }
            my int $deadline = ::body_deadline($server_ref, $body_start, core::byte_length($buffer) - $body_offset);
            my str $more = ::conn_recv($server_ref, $conn, $deadline);
            if (core::byte_length($more) == 0) {
                if ($conn->{"timed_out"} == 1) { return ::read_error("timeout", 0); }
                return undef;
            }
            $buffer = $buffer . $more;
        }
    }

    my int $total_needed = $body_offset + $content_len;
    while (core::byte_length($buffer) < $total_needed) {
        my int $deadline = ::body_deadline($server_ref, $body_start, core::byte_length($buffer) - $body_offset);
        my str $chunk = ::conn_recv($server_ref, $conn, $deadline);
        if (core::byte_length($chunk) == 0) {
            if ($conn->{"timed_out"} == 1) { return ::read_error("timeout", 0); }
            return undef;
        }
        $buffer = $buffer . $chunk;
    }

    my int $buf_total = core::byte_length($buffer);
    my str $request_data = $header_section . "\r\n\r\n" . core::byte_substr($buffer, $body_offset, $content_len);
    my int $remaining_len = $buf_total - $total_needed;
    my str $remaining = "";
    if ($remaining_len > 0) {
        $remaining = core::byte_substr($buffer, $total_needed, $remaining_len);
    }

    my hash %req = Cannoli::Request::parse($request_data);
    my hash %result = ();
    $result{"req"} = \%req;
    $result{"buffer"} = $remaining;
    return \%result;
}

# ===========================================================================
# Client address, request IDs, response finishing
# ===========================================================================

# Dotted-quad to integer; -1 if $ip is not IPv4.
func Cannoli_Server_ipv4_to_int(str $ip) int {
    my array @parts = split("\\.", $ip);   # split() takes a regex
    if (scalar(@parts) != 4) { return -1; }
    my int $v = 0;
    foreach my str $p (@parts) {
        if (::is_decimal($p) == 0 || length($p) > 3) { return -1; }
        my int $o = $p + 0;
        if ($o > 255) { return -1; }
        $v = $v * 256 + $o;
    }
    return $v;
}

func Cannoli_Server_strip_mapped(str $ip) str {
    if (length($ip) > 7 && lc(substr($ip, 0, 7)) eq "::ffff:" && index($ip, ".") > 0) {
        return substr($ip, 7, length($ip) - 7);
    }
    return $ip;
}

# Does $ip match an entry of a comma-separated list of addresses and IPv4
# CIDR blocks ("127.0.0.1, ::1, 10.0.0.0/8")? "*" matches anything.
func Cannoli_Server_ip_in_list(str $ip, str $list) int {
    if (length($list) == 0 || length($ip) == 0) { return 0; }
    my str $norm = ::strip_mapped($ip);
    my int $ip4 = ::ipv4_to_int($norm);
    foreach my str $raw (split(",", $list)) {
        my str $entry = trim($raw);
        if (length($entry) == 0) { next; }
        if ($entry eq "*" || lc($entry) eq lc($ip) || lc($entry) eq lc($norm)) { return 1; }
        my int $slash = index($entry, "/");
        if ($slash > 0 && $ip4 >= 0) {
            my int $net = ::ipv4_to_int(substr($entry, 0, $slash));
            my str $bits_s = substr($entry, $slash + 1, length($entry) - $slash - 1);
            if ($net >= 0 && ::is_decimal($bits_s) == 1) {
                my int $bits = $bits_s + 0;
                if ($bits <= 32) {
                    my int $span = 1;
                    my int $b = 0;
                    while ($b < 32 - $bits) { $span = $span * 2; $b = $b + 1; }
                    if (($ip4 - ($ip4 % $span)) == ($net - ($net % $span))) { return 1; }
                }
            }
        }
    }
    return 0;
}

# Check if IP is in allowed list for admin access
func Cannoli_Server_is_admin_allowed(str $remote_ip, str $allowed_ips) int {
    return ::ip_in_list($remote_ip, $allowed_ips);
}

# Fill in remote_addr / scheme. The socket peer is kept in peer_addr; when
# the peer is a configured trusted proxy, the client address comes from
# X-Forwarded-For (rightmost address that is not itself a trusted proxy)
# and the scheme from X-Forwarded-Proto.
func Cannoli_Server_apply_client_info(scalar $server_ref, scalar $conn, scalar $req) void {
    my str $peer = $conn->{"peer"};
    $req->{"peer_addr"} = $peer;
    $req->{"remote_addr"} = $peer;
    $req->{"scheme"} = $conn->{"tls"} == 1 ? "https" : "http";

    my str $trusted = $server_ref->{"trusted_proxies"};
    if (length($trusted) == 0 || ::ip_in_list($peer, $trusted) == 0) { return; }
    my scalar $hdrs = $req->{"headers"};
    if (!defined($hdrs)) { return; }

    if (exists(%{$hdrs}, "x-forwarded-for")) {
        my array @hops = split(",", $hdrs->{"x-forwarded-for"});
        my int $k = scalar(@hops) - 1;
        my str $client = "";
        while ($k >= 0) {
            my str $hop = trim($hops[$k]);
            if (length($hop) > 0) {
                $client = $hop;
                if (::ip_in_list($hop, $trusted) == 0) { last; }
            }
            $k = $k - 1;
        }
        if (length($client) > 0) { $req->{"remote_addr"} = $client; }
    } elsif (exists(%{$hdrs}, "x-real-ip")) {
        my str $real = trim($hdrs->{"x-real-ip"});
        if (length($real) > 0) { $req->{"remote_addr"} = $real; }
    }
    if (exists(%{$hdrs}, "x-forwarded-proto")) {
        my str $proto = lc(trim($hdrs->{"x-forwarded-proto"}));
        if ($proto eq "https" || $proto eq "http") { $req->{"scheme"} = $proto; }
    }
}

my int $_g_request_seq = 0;

# Request ID: reuse a sane incoming X-Request-Id from a trusted proxy, else
# generate one unique across workers (time, pid, per-worker counter).
func Cannoli_Server_request_id(scalar $server_ref, scalar $req) str {
    my scalar $hdrs = $req->{"headers"};
    if (defined($hdrs) && exists(%{$hdrs}, "x-request-id") && length($server_ref->{"trusted_proxies"}) > 0
        && ::ip_in_list($req->{"peer_addr"}, $server_ref->{"trusted_proxies"}) == 1) {
        my str $in = trim($hdrs->{"x-request-id"});
        if (length($in) > 0 && length($in) <= 128 && $in =~ /^[A-Za-z0-9._:-]+$/) { return $in; }
    }
    $_g_request_seq = $_g_request_seq + 1;
    return sprintf("%x-%x-%x", core::time(), core::getpid(), $_g_request_seq);
}

my int $_g_date_sec = 0;
my str $_g_date_str = "";

# RFC 9110 HTTP-date for the Date header (cached per second).
func Cannoli_Server_http_date() str {
    my int $now = core::time();
    if ($now != $_g_date_sec) {
        $_g_date_sec = $now;
        $_g_date_str = core::strftime("%a, %d %b %Y %H:%M:%S GMT", core::gmtime($now));
    }
    return $_g_date_str;
}

# Headers every response carries: Date, configured [headers] entries the
# application did not set itself, X-Request-Id, Server (server.tokens).
# Values here are generated or validated at startup, so they are stored
# directly (this runs on every response).
func Cannoli_Server_finish_headers(scalar $server_ref, hash %res, str $request_id) hash {
    if (!defined($res{"headers"})) { $res{"headers"} = {}; }
    my scalar $hdrs = $res{"headers"};
    if (!exists(%{$hdrs}, "Date") && Cannoli::Response::has_header(%res, "Date") == 0) {
        $hdrs->{"Date"} = ::http_date();
    }
    my scalar $extra = $server_ref->{"extra_headers"};
    foreach my str $name (keys(%{$extra})) {
        if (Cannoli::Response::has_header(%res, $name) == 0) {
            $hdrs->{$name} = $extra->{$name};
        }
    }
    if (length($request_id) > 0 && $server_ref->{"request_id_header"} == 1) {
        Cannoli::Response::header(%res, "X-Request-Id", $request_id);
    }
    if ($server_ref->{"server_tokens"} == 0) {
        Cannoli::Response::remove_header(%res, "Server");
    } elsif (!exists(%{$hdrs}, "Server") && Cannoli::Response::has_header(%res, "Server") == 0) {
        $hdrs->{"Server"} = "Cannoli/1.0";
    }
    return %res;
}

# Send an error response for a request that could not be read, then close
# without leaving unread input behind.
func Cannoli_Server_send_read_error(scalar $server_ref, scalar $conn, scalar $read_result) void {
    my str $err = $read_result->{"error"};
    my int $limit = $read_result->{"limit"};
    my hash %err_res = ();
    if ($err eq "header_too_large") {
        %err_res = Cannoli::Response::header_too_large($limit);
    } elsif ($err eq "body_too_large") {
        %err_res = Cannoli::Response::payload_too_large($limit);
    } elsif ($err eq "timeout") {
        %err_res = Cannoli::Response::error_page(408, "Request Timeout");
    } elsif ($err eq "expectation_failed") {
        %err_res = Cannoli::Response::error_page(417, "Expectation Failed");
    } else {
        %err_res = Cannoli::Response::error_page(400, "Bad Request");
    }
    Cannoli::Response::header(%err_res, "Connection", "close");
    ::finish_headers($server_ref, %err_res, "");
    my str $err_data = Cannoli::Response::build(%err_res);
    if (::conn_send($server_ref, $conn, $err_data) == 1) {
        ::conn_linger_close($server_ref, $conn);
    } else {
        ::conn_close($server_ref, $conn);
    }
    Cannoli::Log::debug("rejected request from " . $conn->{"peer"} . ": " . $err);
}

# ===========================================================================
# Dispatch
# ===========================================================================

# Route one request: admin endpoint, prefix library routes, chained
# libraries, then the router. Returns {res, c, after}.
func Cannoli_Server_dispatch(scalar $server_ref, scalar $req_ref) scalar {
    my hash %req = %{$req_ref};
    my scalar $router = $server_ref->{"router"};
    my scalar $dispatch_funcs = $server_ref->{"dispatch_funcs"};
    my scalar $after_funcs = $server_ref->{"after_funcs"};
    my scalar $library_routes = $server_ref->{"library_routes"};
    my str $path = $req{"path"};

    my hash %res = ();
    my int $handled = 0;
    my scalar $c = undef;
    my scalar $after_func = undef;

    # Admin endpoint (supports /__admin and /__admin/action). Access is
    # decided by the socket peer, never by forwarded headers.
    my str $admin_path = $server_ref->{"admin_path"};
    my int $admin_path_len = length($admin_path);
    if ($server_ref->{"admin_enabled"} == 1 && length($path) >= $admin_path_len) {
        my int $is_admin = 0;
        my str $admin_action = "";
        if ($path eq $admin_path) {
            $is_admin = 1;
        } elsif (substr($path, 0, $admin_path_len) eq $admin_path && substr($path, $admin_path_len, 1) eq "/") {
            $is_admin = 1;
            $admin_action = substr($path, $admin_path_len + 1, length($path) - $admin_path_len - 1);
        }
        if ($is_admin == 1) {
            my str $peer_ip = $req{"peer_addr"} // "unknown";
            if (::is_admin_allowed($peer_ip, $server_ref->{"admin_allowed_ips"}) == 1) {
                %res = ::handle_admin($server_ref, $peer_ip, $admin_action);
            } else {
                %res = Cannoli::Response::error_page(403, "Forbidden");
            }
            $handled = 1;
        }
    }

    # Prefix-based library routes (library./prefix = path.so)
    my int $num_routes = scalar(@{$library_routes});
    if ($num_routes > 0 && $handled == 0) {
        my int $i = 0;
        while ($i < $num_routes && $handled == 0) {
            my scalar $route = $library_routes->[$i];
            my str $prefix = $route->{"prefix"};
            my int $prefix_len = length($prefix);
            my int $matches = 0;

            if ($prefix eq "/") {
                $matches = 1;
            } elsif (length($path) >= $prefix_len && substr($path, 0, $prefix_len) eq $prefix) {
                # a proper prefix: followed by / or end of path
                if (length($path) == $prefix_len || substr($path, $prefix_len, 1) eq "/"
                    || substr($prefix, $prefix_len - 1, 1) eq "/") {
                    $matches = 1;
                }
            }

            if ($matches == 1) {
                my str $path_info = "/";
                if ($prefix eq "/") {
                    $path_info = $path;
                } elsif (length($path) > $prefix_len) {
                    $path_info = substr($path, $prefix_len, length($path) - $prefix_len);
                }
                $req{"path_info"} = $path_info;
                $c = Cannoli::new(%req);

                my scalar $result = core::dl_call_sv($route->{"dispatch"}, [$c]);
                my str $response_body = defined($result) ? ("" . $result) : "";
                if (length($response_body) > 0) {
                    %res = ::parse_response($response_body);
                    $handled = 1;
                    $after_func = $route->{"after"};
                }
            }
            $i = $i + 1;
        }
    }

    # Chain-of-responsibility dispatch (app.library)
    my int $num_funcs = scalar(@{$dispatch_funcs});
    if ($num_funcs > 0 && $handled == 0) {
        $req{"path_info"} = "";  # Libraries handle their own prefix matching
        $c = Cannoli::new(%req);
        my int $i = 0;
        while ($i < $num_funcs && $handled == 0) {
            my scalar $result = core::dl_call_sv($dispatch_funcs->[$i], [$c]);
            my str $response_body = defined($result) ? ("" . $result) : "";
            if (length($response_body) > 0) {
                %res = ::parse_response($response_body);
                $handled = 1;
                $after_func = $after_funcs->[$i];
            }
            $i = $i + 1;
        }
    }

    if ($handled == 0 && defined($router)) {
        %res = Cannoli::Router::dispatch($router, %req);
        $handled = 1;
    }
    if ($handled == 0) {
        %res = Cannoli::Response::not_found();
    }

    return {"res" => \%res, "c" => $c, "after" => $after_func};
}

# Serve every request on one connection (plain or TLS), then close it.
func Cannoli_Server_handle_connection(scalar $server_ref, scalar $conn) void {
    my str $buffer = "";

    while (1) {
        my scalar $read_result = ::read_request($server_ref, $conn, $buffer);
        if (!defined($read_result)) {
            last;
        }
        if (exists(%{$read_result}, "error")) {
            ::send_read_error($server_ref, $conn, $read_result);
            return;
        }

        $buffer = $read_result->{"buffer"};
        my hash %req = %{$read_result->{"req"}};
        $conn->{"requests"} = $conn->{"requests"} + 1;

        my hash %start_time = core::gettimeofday();
        my int $start_sec = $start_time{"sec"};
        my int $start_usec = $start_time{"usec"};
        my str $method = $req{"method"};

        ::apply_client_info($server_ref, $conn, \%req);
        my str $request_id = ::request_id($server_ref, \%req);
        $req{"request_id"} = $request_id;

        # Raw connection handles for streaming (chunked) responses / websockets
        if ($conn->{"tls"} == 1) {
            $req{"_ssl"} = 1;
            $req{"_ssl_conn"} = $conn->{"ssl"};
            $req{"_ssl_read_fn"} = $server_ref->{"ssl_read_fn"};
            $req{"_ssl_write_fn"} = $server_ref->{"ssl_write_fn"};
            $req{"_ssl_close_fn"} = $server_ref->{"ssl_close_fn"};
        } else {
            $req{"_fd"} = $conn->{"fd"};
            $req{"_client"} = $conn->{"sock"};
        }

        # A handler that throws costs one 500, not the worker (and in a
        # classic worker, not every other connection it would have served).
        my hash %res = ();
        my scalar $c = undef;
        my scalar $after_func = undef;
        my int $failed = 0;
        # Handlers that stream or read on the raw TLS connection (chunked
        # responses, websockets) use the SSL library's blocking wrappers,
        # which give up after 5s on a non-blocking fd. In a classic worker
        # the handler owns the process anyway, so hand it a blocking fd.
        my int $handler_blocking = ($conn->{"tls"} == 1 && $conn->{"nb"} == 1 && $server_ref->{"loop_mode"} != 1) ? 1 : 0;
        if ($handler_blocking == 1) { ::set_blocking($conn->{"fd"}, 1); }
        try {
            my scalar $d = ::dispatch($server_ref, \%req);
            %res = %{$d->{"res"}};
            $c = $d->{"c"};
            $after_func = $d->{"after"};
        } catch ($dispatch_err) {
            Cannoli::Log::error("request " . $request_id . " " . $method . " " . $req{"path"} . " failed: " . $dispatch_err);
            %res = Cannoli::Response::error_page(500, "Internal Server Error");
            $failed = 1;
        }
        if ($handler_blocking == 1) { ::set_blocking($conn->{"fd"}, 0); }

        my int $keep_alive = ::should_keep_alive($server_ref, %req);
        if ($failed == 1) { $keep_alive = 0; }

        # Build and send the response (unless the handler already streamed it)
        my int $send_ok = 1;
        if ($res{"sent"} != 1) {
            if ($method eq "HEAD") {
                if (Cannoli::Response::has_header(%res, "Content-Length") == 0) {
                    my str $head_body = defined($res{"body"}) ? ("" . $res{"body"}) : "";
                    Cannoli::Response::header(%res, "Content-Length", "" . core::byte_length($head_body));
                }
                $res{"body"} = "";
            }
            if ($keep_alive == 1) {
                Cannoli::Response::header(%res, "Connection", "keep-alive");
                Cannoli::Response::header(%res, "Keep-Alive", "timeout=" . $server_ref->{"keep_alive_timeout"});
            } else {
                Cannoli::Response::header(%res, "Connection", "close");
            }
            ::finish_headers($server_ref, %res, $request_id);
            $send_ok = ::conn_send($server_ref, $conn, Cannoli::Response::build(%res));
        }

        my hash %end_time = core::gettimeofday();
        my int $elapsed_ms = ($end_time{"sec"} - $start_sec) * 1000 + ($end_time{"usec"} - $start_usec) / 1000;

        Cannoli::Log::request_timed(%req, %res, $elapsed_ms);
        ::record_request($elapsed_ms);

        if (defined($after_func) && defined($c)) {
            try {
                core::dl_call_void_sv($after_func, [$c, $elapsed_ms]);
            } catch ($after_err) {
                Cannoli::Log::error("cannoli_after_request: " . $after_err);
            }
        }

        if ($res{"sent"} == 1 || $send_ok == 0) {
            last;
        }
        if ($res{"_exit_after"} == 1) {
            ::conn_close($server_ref, $conn);
            ::worker_exit();
        }
        if ($keep_alive == 0) {
            last;
        }
    }

    ::conn_close($server_ref, $conn);
}

# Legacy entry points (plain socket / TLS handle).
func Cannoli_Server_handle_client(scalar $server_ref, scalar $client) void {
    ::handle_connection($server_ref, ::plain_conn($client));
}

func Cannoli_Server_handle_ssl_client(scalar $server_ref, scalar $ssl_conn) void {
    ::handle_connection($server_ref, ::tls_conn($server_ref, $ssl_conn));
}

# Handle admin endpoint request - returns JSON stats
# action: "" for status, "kill" to terminate worker
func Cannoli_Server_handle_admin(scalar $server_ref, str $remote_ip, str $action) hash {
    # Handle kill action
    if ($action eq "kill") {
        my int $pid = core::getpid();
        my str $json = "{\n";
        $json = $json . "  \"status\": \"ok\",\n";
        $json = $json . "  \"action\": \"kill\",\n";
        $json = $json . "  \"message\": \"Worker " . $pid . " will terminate after this response\",\n";
        $json = $json . "  \"pid\": " . $pid . "\n";
        $json = $json . "}";

        my hash %res = Cannoli::Response::json(200, $json);
        $res{"_exit_after"} = 1;  # Signal to exit after response
        return %res;
    }

    # Calculate worker uptime
    my hash %now = core::gettimeofday();
    my int $uptime_sec = $now{"sec"} - $_g_worker_start_sec;

    # Calculate average response time
    my int $avg_time_ms = 0;
    if ($_g_worker_requests > 0) {
        $avg_time_ms = $_g_worker_total_time_ms / $_g_worker_requests;
    }

    # Build JSON response
    my str $json = "{\n";
    $json = $json . "  \"status\": \"ok\",\n";
    $json = $json . "  \"worker\": {\n";
    $json = $json . "    \"pid\": " . core::getpid() . ",\n";
    $json = $json . "    \"uptime_sec\": " . $uptime_sec . ",\n";
    $json = $json . "    \"requests\": " . $_g_worker_requests . ",\n";
    $json = $json . "    \"avg_response_ms\": " . $avg_time_ms . "\n";
    $json = $json . "  },\n";
    $json = $json . "  \"server\": {\n";
    $json = $json . "    \"host\": \"" . Cannoli::Log::json_escape($server_ref->{"host"}) . "\",\n";
    $json = $json . "    \"port\": " . $server_ref->{"port"} . ",\n";
    $json = $json . "    \"num_workers\": " . $server_ref->{"num_workers"} . ",\n";
    $json = $json . "    \"max_requests\": " . $server_ref->{"max_requests"} . ",\n";
    $json = $json . "    \"ssl_enabled\": " . ($server_ref->{"ssl_enabled"} == 1 ? "true" : "false") . "\n";
    $json = $json . "  },\n";
    $json = $json . "  \"client\": {\n";
    $json = $json . "    \"remote_ip\": \"" . Cannoli::Log::json_escape($remote_ip) . "\"\n";
    $json = $json . "  }\n";
    $json = $json . "}";

    my hash %res = Cannoli::Response::json(200, $json);
    return %res;
}

# Worker process main loop
func Cannoli_Server_worker_loop(scalar $server_ref) void {
    if ($server_ref->{"loop_mode"} == 1) {
        ::loop_worker_loop($server_ref);
        return;
    }
    my scalar $server_sock = $server_ref->{"server_sock"};
    my scalar $ssl_server = $server_ref->{"ssl_server"};
    my int $max_requests = $server_ref->{"max_requests"};

    # Save parent PID to detect if master dies
    my int $parent_pid = core::getppid();

    my int $http_fd = -1;
    if (defined($server_sock)) {
        $http_fd = core::socket_fd($server_sock);
    }
    my int $ssl_fd = -1;
    if (defined($ssl_server)) {
        my scalar $ssl_fd_fn = $server_ref->{"ssl_fd_fn"};
        $ssl_fd = core::dl_call_int_sv($ssl_fd_fn, [$ssl_server]);
    }

    if ($http_fd < 0 && $ssl_fd < 0) {
        return;
    }

    while ($max_requests <= 0 || $_g_worker_requests < $max_requests) {
        # Check if master process died (orphaned worker)
        my int $current_ppid = core::getppid();
        if ($current_ppid != $parent_pid) {
            # Master died, exit cleanly
            ::worker_exit();
        }

        # Build array of file descriptors to monitor
        my array @fds = ();
        if ($http_fd >= 0) {
            push(\@fds, $http_fd);
        }
        if ($ssl_fd >= 0) {
            push(\@fds, $ssl_fd);
        }

        # Wait for connections on either socket
        my array @ready = core::select_fds(\@fds, 1000);
        my int $num_ready = scalar(@ready);

        if ($num_ready == 0) {
            next;
        }

        my int $i = 0;
        $_g_worker_busy = 1;
        while ($i < $num_ready) {
            my int $ready_fd = $ready[$i];

            if ($ready_fd == $http_fd) {
                # HTTP connection
                my scalar $client = core::socket_accept($server_sock);
                if (defined($client)) {
                    my scalar $pc = ::plain_conn($client);
                    try {
                        ::handle_connection($server_ref, $pc);
                    } catch ($conn_err) {
                        Cannoli::Log::error("connection from " . $pc->{"peer"} . " failed: " . $conn_err);
                        ::conn_close($server_ref, $pc);
                    }
                }
            } elsif ($ready_fd == $ssl_fd) {
                # HTTPS connection
                my scalar $tls = ::accept_tls($server_ref, $ssl_server);
                if (defined($tls)) {
                    try {
                        ::handle_connection($server_ref, $tls);
                    } catch ($tls_err) {
                        Cannoli::Log::error("TLS connection from " . $tls->{"peer"} . " failed: " . $tls_err);
                        ::conn_close($server_ref, $tls);
                    }
                }
            }

            $i = $i + 1;
        }
        $_g_worker_busy = 0;
        if ($_g_exit_requested == 1) { ::worker_exit(); }
    }

    # Worker exits after max requests (will be respawned by master)
}


# Strada signal handlers are not dispatched while an Async::Loop is
# running green tasks, so a loop worker never saw its SIGTERM (it was always
# SIGKILLed after shutdown_timeout, mid-request). Loop workers therefore use
# a raw C handler that only sets a flag; the watchdog task polls it.
__C__ {
#include <signal.h>
#include <fcntl.h>
static volatile sig_atomic_t cannoli_raw_term_flag = 0;
static void cannoli_raw_term_handler(int s) { (void)s; cannoli_raw_term_flag = 1; }
}

# Switch an fd between blocking and non-blocking mode.
func Cannoli_Server_set_blocking(int $fd, int $blocking) void {
    __C__ {
        int f = (int)strada_to_int(fd);
        int fl = fcntl(f, F_GETFL, 0);
        if (fl >= 0) {
            if (strada_to_int(blocking)) fl &= ~O_NONBLOCK; else fl |= O_NONBLOCK;
            fcntl(f, F_SETFL, fl);
        }
    }
}

func Cannoli_Server_install_raw_term() void {
    __C__ {
        struct sigaction sa;
        memset(&sa, 0, sizeof(sa));
        sa.sa_handler = cannoli_raw_term_handler;
        sigemptyset(&sa.sa_mask);
        sa.sa_flags = 0;
        sigaction(SIGTERM, &sa, NULL);
    }
}

func Cannoli_Server_raw_term_seen() int {
    my scalar $seen = 0;
    __C__ {
        seen = strada_new_int(cannoli_raw_term_flag ? 1 : 0);
    }
    return $seen;
}

# Event-loop worker (server.loop_workers = 1): instead of one connection at
# a time, this worker runs an Async::Loop where every connection is a green
# task. Keep-alive and slow clients park a coroutine instead of pinning the
# whole worker; N acceptor tasks pull from the shared listener (the kernel
# load-balances accepts across the preforked workers as before).
#
# v1 notes:
#  - HTTP only: with ssl.enabled the TLS port is still served by classic
#    workers semantics (loop workers ignore it and a warning is logged).
#  - Anything blocking inside a handler (DBI, file I/O) stalls this worker's
#    loop for its duration; other preforked workers keep serving.
func Cannoli_Server_loop_worker_loop(scalar $server_ref) void {
    my scalar $server_sock = $server_ref->{"server_sock"};
    my scalar $loop_ssl_server = $server_ref->{"ssl_server"};
    my int $loop_ssl_ok = 0;
    if (defined($loop_ssl_server)) {
        if (defined($server_ref->{"ssl_try_accept_fn"})
            && defined($server_ref->{"ssl_handshake_step_fn"})
            && defined($server_ref->{"ssl_try_read_fn"})
            && defined($server_ref->{"ssl_try_write_fn"})) {
            $loop_ssl_ok = 1;
        } else {
            Cannoli::Log::warn("loop_workers=1: SSL library lacks non-blocking entry points (rebuild libstrada_ssl.so); TLS port not served by loop workers");
        }
    }

    if (!defined($server_sock) && $loop_ssl_ok == 0) {
        if (defined($loop_ssl_server)) {
            Cannoli::Log::warn("loop_workers: falling back to classic worker for blocking SSL listener");
            $server_ref->{"loop_mode"} = 0;
            ::worker_loop($server_ref);
        } else {
            Cannoli::Log::error("loop_workers: no HTTP or SSL socket available");
        }
        return;
    }

    # tasks interleave, so SIGTERM always defers to the watchdog below
    $_g_worker_busy = 1;
    ::install_raw_term();
    my int $max_requests = $server_ref->{"max_requests"};
    my int $acceptors = $server_ref->{"loop_acceptors"};
    if ($acceptors < 1) { $acceptors = 1; }
    my int $parent_pid = core::getppid();

    Cannoli::Log::info("worker " . core::getpid() . ": event-loop mode, " . $acceptors . " acceptors");
    my scalar $loop = Async::Loop::new();
    my scalar $state = { "served" => 0, "draining" => 0 };

    # Watchdog task: exit if the master dies; drain gracefully on SIGTERM or
    # after max_requests connections have been handled.
    $loop->spawn(fn () {
        while (1) {
            Async::Task::sleep(1000);
            if (core::getppid() != $parent_pid) {
                ::worker_exit();
            }
            if (::raw_term_seen() == 1) {
                $_g_exit_requested = 1;
            }
            if ($_g_exit_requested == 1) {
                $state->{"draining"} = 1;
            }
            if ($state->{"draining"} == 1) {
                last;
            }
        }
    });

    if (defined($server_sock)) {
        my int $a = 0;
        while ($a < $acceptors) {
            $loop->spawn(fn () {
                while ($state->{"draining"} == 0) {
                    my scalar $client = Async::Task::accept($server_sock, 1000);
                    if (!defined($client)) {
                        next;   # timeout tick: re-check draining
                    }
                    $loop->spawn(fn () {
                        # On an uncaught handler exception the normal close in
                        # handle_client is skipped -- close here or the client
                        # hangs until its own timeout (observed with a failed
                        # db_connect in sysync-web).
                        my scalar $pconn = ::plain_conn($client);
                        try {
                            ::handle_connection($server_ref, $pconn);   # closes the connection itself
                        } catch ($handler_err) {
                            Cannoli::Log::error("handler died: " . $handler_err);
                            ::conn_close($server_ref, $pconn);
                        }
                        $state->{"served"} = $state->{"served"} + 1;
                        if ($max_requests > 0 && $state->{"served"} >= $max_requests) {
                            $state->{"draining"} = 1;
                        }
                    });
                }
            });
            $a = $a + 1;
        }
    }

    # TLS acceptor tasks: park on the TLS listener, try-accept without
    # blocking, then drive the handshake step-by-step (parking on whichever
    # readiness OpenSSL asks for) before handing the connection to the
    # regular SSL request handler. One slow handshake never stalls the loop.
    if ($loop_ssl_ok == 1) {
        my int $ssl_srv_fd = core::dl_call_int_sv($server_ref->{"ssl_fd_fn"}, [$loop_ssl_server]);
        my int $sa = 0;
        while ($sa < $acceptors) {
            $loop->spawn(fn () {
                while ($state->{"draining"} == 0) {
                    my scalar $ssl_conn = core::dl_call_sv($server_ref->{"ssl_try_accept_fn"}, [$loop_ssl_server]);
                    if (!defined($ssl_conn)) {
                        # Nothing pending: park until the listener is
                        # readable (1s tick to re-check draining).
                        core::coro_yield_io($ssl_srv_fd, "r", 1000);
                        next;
                    }
                    $loop->spawn(fn () {
                        my int $cfd = core::dl_call_int_sv($server_ref->{"ssl_fd_fn"}, [$ssl_conn]);
                        # Handshake within header_timeout so dead clients
                        # can't park a task forever.
                        my int $hs_deadline = core::mono_ms() + $server_ref->{"header_timeout"} * 1000;
                        my int $hs_ok = 0;
                        while (1) {
                            my int $st = core::dl_call_int_sv($server_ref->{"ssl_handshake_step_fn"}, [$ssl_conn]);
                            if ($st == 0) { $hs_ok = 1; last; }
                            if ($st < 0) { last; }
                            my int $hs_left = $hs_deadline - core::mono_ms();
                            if ($hs_left <= 0) { last; }
                            core::coro_yield_io($cfd, $st == 2 ? "w" : "r", $hs_left);
                        }
                        if ($hs_ok == 1) {
                            my scalar $tconn = ::tls_conn($server_ref, $ssl_conn);
                            try {
                                ::handle_connection($server_ref, $tconn);   # closes the conn
                            } catch ($ssl_handler_err) {
                                Cannoli::Log::error("ssl handler died: " . $ssl_handler_err);
                                ::conn_close($server_ref, $tconn);
                            }
                        } else {
                            core::dl_call_void_sv($server_ref->{"ssl_close_fn"}, [$ssl_conn]);
                        }
                        $state->{"served"} = $state->{"served"} + 1;
                        if ($max_requests > 0 && $state->{"served"} >= $max_requests) {
                            $state->{"draining"} = 1;
                        }
                    });
                }
            });
            $sa = $sa + 1;
        }
    }

    $loop->run();
    # Worker exits after max requests (will be respawned by master)
}

# Spawn worker processes
# The ticker: call every cannoli_tick hook, sleep, repeat. A tick that
# throws is logged and the next one runs on schedule. After tick_max
# ticks it exits and the master starts a fresh one (as with max_requests).
func Cannoli_Server_ticker_loop(scalar $server_ref) void {
    my int $interval = $server_ref->{"tick_interval"};
    my int $max = $server_ref->{"tick_max"};
    my int $parent_pid = core::getppid();
    my int $n = 0;
    while ($max <= 0 || $n < $max) {
        $_g_worker_busy = 1;
        foreach my scalar $fn (@{$_g_tick_funcs}) {
            try { core::dl_call_void_sv($fn, []); } catch ($e) { Cannoli::Log::error("cannoli_tick: " . $e); }
        }
        $_g_worker_busy = 0;
        if ($_g_exit_requested == 1) { return; }
        $n = $n + 1;
        # sleep in short steps so SIGTERM and an exited master are noticed
        my int $waited = 0;
        while ($waited < $interval * 10) {
            if ($_g_exit_requested == 1 || core::getppid() != $parent_pid) { return; }
            core::usleep(100000);
            $waited = $waited + 1;
        }
    }
}

func Cannoli_Server_is_ticker(scalar $server_ref, int $pid) int {
    foreach my int $p (@{$server_ref->{"ticker_pids"}}) { if ($p == $pid) { return 1; } }
    return 0;
}

func Cannoli_Server_spawn_tickers(scalar $server_ref) void {
    my int $n = $server_ref->{"tickers"};
    if ($n < 1) { $n = 1; }
    my int $i = 0;
    while ($i < $n) { ::spawn_ticker($server_ref); $i = $i + 1; }
}

# Fork a ticker (when a library has cannoli_tick and it is enabled).
func Cannoli_Server_spawn_ticker(scalar $server_ref) void {
    if (scalar(@{$_g_tick_funcs}) == 0 || $server_ref->{"tick_interval"} <= 0) { return; }
    my int $pid = core::fork();
    if ($pid == 0) {
        core::setproctitle("cannoli [ticker]");
        core::signal("TERM", \&Cannoli_Server_worker_handle_term);
        core::signal("INT", "IGNORE");
        core::signal("HUP", "IGNORE");
        ::ticker_loop($server_ref);
        ::worker_exit();
    } elsif ($pid > 0) {
        push(@{$server_ref->{"ticker_pids"}}, $pid);
        push(@{$server_ref->{"worker_pids"}}, $pid);
        $server_ref->{"spawn_times"}->{"" . $pid} = core::mono_ms();
        say("Spawned ticker with PID " . $pid . " (every " . $server_ref->{"tick_interval"} . "s)");
    } else {
        say("Error: fork() failed for the ticker");
    }
}

# Fork one request worker. Returns its pid (or -1).
func Cannoli_Server_spawn_worker(scalar $server_ref) int {
    my int $pid = core::fork();
    if ($pid == 0) {
        core::setproctitle("cannoli [worker]");
        core::signal("TERM", \&Cannoli_Server_worker_handle_term);
        core::signal("INT", "IGNORE");  # Let master handle Ctrl+C
        core::signal("HUP", "IGNORE");  # Only the master rotates workers
        ::init_worker_stats();
        ::worker_loop($server_ref);
        ::worker_exit();
    }
    if ($pid > 0) {
        push(@{$server_ref->{"worker_pids"}}, $pid);
        $server_ref->{"spawn_times"}->{"" . $pid} = core::mono_ms();
    } else {
        Cannoli::Log::error("fork() failed spawning a worker");
    }
    return $pid;
}

func Cannoli_Server_spawn_workers(scalar $server_ref) void {
    my int $i = 0;
    while ($i < $server_ref->{"num_workers"}) {
        my int $pid = ::spawn_worker($server_ref);
        if ($pid > 0) { say("Spawned worker " . ($i + 1) . " with PID " . $pid); }
        $i = $i + 1;
    }
}

# Global server reference for signal handlers
my scalar $_g_server_ref = undef;

# Per-worker stats (reset on worker start)
my int $_g_worker_requests = 0;
my int $_g_worker_start_sec = 0;
my int $_g_worker_start_usec = 0;
my int $_g_worker_total_time_ms = 0;  # Total response time for averaging

# Initialize worker stats (called when worker starts)
func Cannoli_Server_init_worker_stats() void {
    $_g_worker_requests = 0;
    $_g_worker_total_time_ms = 0;
    my hash %now = core::gettimeofday();
    $_g_worker_start_sec = $now{"sec"};
    $_g_worker_start_usec = $now{"usec"};
}

# Record a completed request
func Cannoli_Server_record_request(int $elapsed_ms) void {
    $_g_worker_requests = $_g_worker_requests + 1;
    $_g_worker_total_time_ms = $_g_worker_total_time_ms + $elapsed_ms;
}

# Worker signal handler for SIGTERM - exit cleanly
func Cannoli_Server_worker_handle_term(int $sig) void {
    defined($sig);
    # mid-request: finish the response first (the loop checks the flag)
    if ($_g_worker_busy == 1) { $_g_exit_requested = 1; return; }
    ::worker_exit();
}

# Run the libraries' cannoli_worker_exit hooks (once), then exit.
func Cannoli_Server_worker_exit() void {
    if ($_g_exiting == 0) {
        $_g_exiting = 1;
        foreach my scalar $fn (@{$_g_exit_funcs}) {
            try { core::dl_call_void_sv($fn, []); } catch ($e) { Cannoli::Log::error("cannoli_worker_exit: " . $e); }
        }
    }
    exit(0);
}

# Signal handler for SIGINT (Ctrl+C)
func Cannoli_Server_handle_sigint(int $sig) void {
    defined($sig);
    if (defined($_g_server_ref)) {
        ::graceful_shutdown($_g_server_ref);
    }
}

# Signal handler for SIGTERM
func Cannoli_Server_handle_sigterm(int $sig) void {
    defined($sig);
    if (defined($_g_server_ref)) {
        ::graceful_shutdown($_g_server_ref);
    }
}

# Keep signal handlers minimal: the master loop performs the actual rotation.
func Cannoli_Server_handle_sighup(int $sig) void {
    defined($sig);
    $_g_reload_requested = 1;
}

# Install signal handlers for graceful shutdown
func Cannoli_Server_install_signal_handlers(scalar $server_ref) void {
    $_g_server_ref = $server_ref;
    core::signal("INT", \&Cannoli_Server_handle_sigint);
    core::signal("TERM", \&Cannoli_Server_handle_sigterm);
    core::signal("HUP", \&Cannoli_Server_handle_sighup);
    core::signal("PIPE", "IGNORE");  # Ignore broken pipe
}

func Cannoli_Server_forget_child(scalar $server_ref, int $pid) void {
    my array @active = ();
    foreach my int $p (@{$server_ref->{"worker_pids"}}) {
        if ($p != $pid) { push(@active, $p); }
    }
    $server_ref->{"worker_pids"} = \@active;

    my array @tickers = ();
    foreach my int $p (@{$server_ref->{"ticker_pids"}}) {
        if ($p != $pid) { push(@tickers, $p); }
    }
    $server_ref->{"ticker_pids"} = \@tickers;
}

# waitpid returns status rather than PID in Strada, so check liveness after
# attempting the non-blocking reap.
func Cannoli_Server_reap_one(scalar $server_ref) int {
    foreach my int $pid (@{$server_ref->{"worker_pids"}}) {
        my int $status = core::waitpid($pid, 1);
        if (core::kill($pid, 0) != 0) {
            # raw wait status: 0 = clean exit(0) (max_requests, SIGTERM),
            # > 0 = non-zero exit or killed by a signal
            $server_ref->{"last_status"} = $status;
            return $pid;
        }
    }
    return 0;
}

# Start replacements before draining the old generation. This reloads the
# already-loaded application generation; listener/config changes require a
# new master process.
func Cannoli_Server_rotate_workers(scalar $server_ref) void {
    my array @old = ();
    foreach my int $pid (@{$server_ref->{"worker_pids"}}) { push(@old, $pid); }

    say("SIGHUP: starting a fresh worker generation...");
    if ($server_ref->{"http"} != 0) {
        ::spawn_workers($server_ref);
    }
    ::spawn_tickers($server_ref);

    my scalar $retiring = $server_ref->{"retiring_pids"};
    my int $kill_at = core::mono_ms() + $server_ref->{"shutdown_timeout"} * 1000;
    foreach my int $pid (@old) {
        $retiring->{"" . $pid} = 1;
        $server_ref->{"retire_deadlines"}->{"" . $pid} = $kill_at;
        core::kill($pid, 15);
    }
    say("SIGHUP: draining " . scalar(@old) . " old worker(s)");
}

# Graceful shutdown - close sockets, wait for workers, cleanup
func Cannoli_Server_graceful_shutdown(scalar $server_ref) void {
    # Prevent multiple shutdown calls
    if ($server_ref->{"running"} == 0) {
        return;
    }

    say("\nGraceful shutdown initiated...");
    $server_ref->{"running"} = 0;

    # Close listening sockets first to stop accepting new connections
    my scalar $server_sock = $server_ref->{"server_sock"};
    if (defined($server_sock)) {
        say("Closing HTTP listening socket...");
        core::socket_close($server_sock);
        $server_ref->{"server_sock"} = undef;
    }

    # Close SSL socket if present
    if ($server_ref->{"ssl_enabled"} == 1) {
        my scalar $ssl_server = $server_ref->{"ssl_server"};
        if (defined($ssl_server)) {
            say("Closing HTTPS listening socket...");
            my scalar $ssl_close_fn = $server_ref->{"ssl_close_fn"};
            if (defined($ssl_close_fn)) {
                core::dl_call_void_sv($ssl_close_fn, [$ssl_server]);
            }
            $server_ref->{"ssl_server"} = undef;
        }
    }

    # Send SIGTERM to all workers
    my scalar $pids = $server_ref->{"worker_pids"};
    my int $num = scalar(@{$pids});
    my int $i = 0;

    if ($num > 0) {
        say("Sending SIGTERM to " . $num . " workers...");
        while ($i < $num) {
            my int $pid = $pids->[$i];
            core::kill($pid, 15);  # SIGTERM
            $i = $i + 1;
        }

        # Wait for the workers to exit. core::waitpid() returns the child's
        # exit STATUS (not its pid), so the old "pid > 0" countdown never
        # moved for workers that exited 0 and every shutdown sat out the
        # full 30s timeout. Instead: reap each worker without blocking and
        # check whether it still exists.
        my int $timeout = $server_ref->{"shutdown_timeout"};  # seconds before SIGKILL
        my int $start = core::time();
        say("Waiting for workers to exit...");
        my int $alive = $num;
        while ($alive > 0) {
            $alive = 0;
            $i = 0;
            while ($i < $num) {
                my int $wpid = $pids->[$i];
                core::waitpid($wpid, 1);  # WNOHANG: reap it if it has exited
                if (core::kill($wpid, 0) == 0) {
                    $alive = $alive + 1;
                }
                $i = $i + 1;
            }
            if ($alive == 0) {
                last;
            }
            if (core::time() - $start >= $timeout) {
                say("Timeout reached, force-killing " . $alive . " worker(s)...");
                $i = 0;
                while ($i < $num) {
                    my int $kill_pid = $pids->[$i];
                    core::kill($kill_pid, 9);  # SIGKILL
                    core::waitpid($kill_pid, 0);
                    $i = $i + 1;
                }
                last;
            }
            core::usleep(20000);  # 20ms
        }
        say("All workers exited");
    }

    ::remove_pid_file($server_ref);
    say("Shutdown complete");

    # In single-process dev mode (no workers), exit immediately
    # Otherwise the main loop may try to use closed sockets
    if ($num == 0) {
        exit(0);
    }
}

# Legacy signal handler for graceful Cannoli::Server::shutdown(kept for compatibility)
func Cannoli_Server_shutdown(scalar $server_ref) void {
    ::graceful_shutdown($server_ref);
}

# Master process loop - monitor and respawn workers
func Cannoli_Server_master_loop(scalar $server_ref) void {
    $server_ref->{"running"} = 1;

    while ($server_ref->{"running"} == 1) {
        if ($_g_reload_requested == 1) {
            $_g_reload_requested = 0;
            ::rotate_workers($server_ref);
        }

        # Poll known children so SIGHUP remains responsive even when signal()
        # would restart a blocking wait().
        my int $pid = ::reap_one($server_ref);

        if ($pid > 0 && $server_ref->{"running"} == 1) {
            my int $was_ticker = ::is_ticker($server_ref, $pid);
            ::forget_child($server_ref, $pid);

            my scalar $retiring = $server_ref->{"retiring_pids"};
            my str $pid_key = "" . $pid;
            my int $born = 0;
            if (exists($server_ref->{"spawn_times"}->{$pid_key})) {
                $born = $server_ref->{"spawn_times"}->{$pid_key};
                delete($server_ref->{"spawn_times"}->{$pid_key});
            }
            delete($server_ref->{"retire_deadlines"}->{$pid_key});
            if (exists($retiring->{$pid_key})) {
                delete($retiring->{$pid_key});
                say("Retired worker " . $pid);
                core::usleep(20000);
                next;
            }

            # Crash-loop guard: a worker that crashes within 2s of starting
            # (bad library, unreachable database, ...) is respawned with an
            # exponential delay (up to 30s) instead of a fork storm.
            if ($born > 0 && core::mono_ms() - $born < 2000 && $server_ref->{"last_status"} > 0) {
                $server_ref->{"crash_streak"} = $server_ref->{"crash_streak"} + 1;
            } else {
                $server_ref->{"crash_streak"} = 0;
            }
            my int $streak = $server_ref->{"crash_streak"};
            if ($streak > 1) {
                my int $delay_ms = 250;
                my int $k = 2;
                while ($k < $streak && $delay_ms < 30000) { $delay_ms = $delay_ms * 2; $k = $k + 1; }
                if ($delay_ms > 30000) { $delay_ms = 30000; }
                Cannoli::Log::error("worker " . $pid . " exited " . $streak . " times in a row right after starting; respawning in " . $delay_ms . "ms");
                my int $until = core::mono_ms() + $delay_ms;
                while (core::mono_ms() < $until && $server_ref->{"running"} == 1 && $_g_reload_requested == 0) {
                    core::usleep(50000);
                }
                if ($server_ref->{"running"} != 1) { last; }
            }

            say("Worker " . $pid . " exited, respawning...");

            if ($was_ticker == 1) {
                ::spawn_ticker($server_ref);
                core::usleep(100000);
                next;
            }

            my int $new_pid = ::spawn_worker($server_ref);
            if ($new_pid > 0) {
                say("Respawned worker with PID " . $new_pid);
            }
        }

        # Old-generation workers that outstay shutdown_timeout after a
        # SIGHUP (a long-poll, a websocket, a stuck handler) are killed so
        # repeated reloads cannot accumulate processes.
        my scalar $deadlines = $server_ref->{"retire_deadlines"};
        my int $now_ms = core::mono_ms();
        foreach my str $rk (keys(%{$deadlines})) {
            if ($now_ms >= $deadlines->{$rk}) {
                Cannoli::Log::warn("retiring worker " . $rk . " did not exit within " . $server_ref->{"shutdown_timeout"} . "s; sending SIGKILL");
                core::kill($rk + 0, 9);
                delete($deadlines->{$rk});
            }
        }

        core::usleep(100000);
    }
}

# ===========================================================================
# Process management: pid file, privilege drop
# ===========================================================================

__C__ {
#include <pwd.h>
#include <grp.h>
#include <unistd.h>
#include <errno.h>
#include <string.h>
}

# Switch to server.user / server.group after the listening sockets are
# bound. Supplementary groups are reset (initgroups for the target user, or
# just the target group), then setgid, then setuid; finally we verify root
# cannot be regained. Returns "" on success or an error message.
func Cannoli_Server_drop_privileges_c(str $user, str $group, str $own_paths = "") str {
    my str $err = "";
    __C__ {
        char *u = strada_to_str(user);
        char *g = strada_to_str(group);
        char *paths = strada_to_str(own_paths);
        char msg[256];
        msg[0] = '\0';
        uid_t uid = (uid_t)-1;
        gid_t gid = (gid_t)-1;
        struct passwd *pw = NULL;
        if (u && *u) {
            pw = getpwnam(u);
            if (!pw) snprintf(msg, sizeof(msg), "unknown user '%s'", u);
            else { uid = pw->pw_uid; gid = pw->pw_gid; }
        }
        if (!msg[0] && g && *g) {
            struct group *gr = getgrnam(g);
            if (!gr) snprintf(msg, sizeof(msg), "unknown group '%s'", g);
            else gid = gr->gr_gid;
        }
        /* Files the unprivileged processes must keep writing (logs, which
         * are reopened on every write) were created as root: hand them over. */
        if (!msg[0] && paths && *paths) {
            char *save = NULL;
            for (char *pth = strtok_r(paths, "\n", &save); pth; pth = strtok_r(NULL, "\n", &save)) {
                if (*pth && chown(pth, uid, gid) != 0 && errno != ENOENT) {
                    snprintf(msg, sizeof(msg), "chown %s failed: %s", pth, strerror(errno));
                    break;
                }
            }
        }
        if (!msg[0] && gid != (gid_t)-1) {
            int rc = pw ? initgroups(pw->pw_name, gid) : setgroups(1, &gid);
            if (rc != 0) snprintf(msg, sizeof(msg), "setting supplementary groups failed: %s", strerror(errno));
            else if (setgid(gid) != 0) snprintf(msg, sizeof(msg), "setgid(%d) failed: %s", (int)gid, strerror(errno));
        }
        if (!msg[0] && uid != (uid_t)-1) {
            if (setuid(uid) != 0) snprintf(msg, sizeof(msg), "setuid(%d) failed: %s", (int)uid, strerror(errno));
            else if (uid != 0 && setuid(0) == 0) snprintf(msg, sizeof(msg), "privileges could be regained after setuid(%d)", (int)uid);
        }
        free(u);
        free(g);
        free(paths);
        err = strada_new_str(msg);
    }
    return $err;
}

func Cannoli_Server_drop_privileges(scalar $server_ref) int {
    my str $user = $server_ref->{"user"};
    my str $group = $server_ref->{"group"};
    if (length($user) == 0 && length($group) == 0) { return 1; }
    if (core::geteuid() != 0) {
        say("Note: server.user/server.group ignored (not started as root)");
        return 1;
    }
    my str $err = ::drop_privileges_c($user, $group, join("\n", Cannoli::Log::files()));
    if (length($err) > 0) {
        say(STDERR, "Error: could not drop privileges: " . $err);
        return 0;
    }
    say("Running as user " . (length($user) > 0 ? $user : "(unchanged)") . ", group " . (length($group) > 0 ? $group : "(user's)"));
    return 1;
}

func Cannoli_Server_write_pid_file(scalar $server_ref) int {
    my str $path = $server_ref->{"pid_file"};
    if (length($path) == 0) { return 1; }
    my str $tmp = $path . ".tmp";
    my scalar $fh = core::open($tmp, "w");
    if (!defined($fh)) {
        say(STDERR, "Error: cannot write pid file " . $path);
        return 0;
    }
    core::fwrite($fh, core::getpid() . "\n");
    core::close($fh);
    if (core::rename($tmp, $path) != 0) {
        say(STDERR, "Error: cannot write pid file " . $path);
        core::unlink($tmp);
        return 0;
    }
    $server_ref->{"pid_written"} = core::getpid();
    return 1;
}

func Cannoli_Server_remove_pid_file(scalar $server_ref) void {
    if (length($server_ref->{"pid_file"}) == 0) { return; }
    # only the master that wrote it removes it
    if (exists(%{$server_ref}, "pid_written") && $server_ref->{"pid_written"} == core::getpid()) {
        core::unlink($server_ref->{"pid_file"});
    }
}

# Pid file + privilege drop, after sockets are bound and before workers fork.
func Cannoli_Server_prepare_master(scalar $server_ref) int {
    if (::write_pid_file($server_ref) == 0) { return 0; }
    if (::drop_privileges($server_ref) == 0) {
        ::remove_pid_file($server_ref);
        return 0;
    }
    return 1;
}

# Run the server in preforking mode
func Cannoli_Server_run(scalar $server_ref) int {
    $server_ref->{"single_process"} = 0;

    if ($server_ref->{"http"} == 0) {
        # a background-job server: tickers only
        if (scalar(@{$_g_tick_funcs}) == 0) {
            say("Error: server.http = 0 but no library exports cannoli_tick");
            return 1;
        }
        if (::prepare_master($server_ref) == 0) { return 1; }
        ::install_signal_handlers($server_ref);
        core::setproctitle("cannoli [master]");
        say("No HTTP (server.http = 0): starting " . $server_ref->{"tickers"} . " ticker(s)");
        ::spawn_tickers($server_ref);
        ::master_loop($server_ref);
        return 0;
    }

    # Create HTTP listening socket (unless ssl_only mode)
    if ($server_ref->{"ssl_only"} != 1) {
        my scalar $server_sock = ::create_socket($server_ref);
        if (!defined($server_sock)) {
            return 1;
        }
    }

    # Create SSL listening socket if SSL is enabled
    if ($server_ref->{"ssl_requested"} == 1) {
        if ($server_ref->{"ssl_enabled"} != 1) {
            say("Error: SSL was requested but SSL library could not be loaded");
            if (defined($server_ref->{"server_sock"})) {
                core::socket_close($server_ref->{"server_sock"});
            }
            return 1;
        }
        my scalar $ssl_srv = ::create_ssl_socket($server_ref);
        if (!defined($ssl_srv)) {
            if (defined($server_ref->{"server_sock"})) {
                core::socket_close($server_ref->{"server_sock"});
            }
            return 1;
        }
    } elsif ($server_ref->{"ssl_only"} == 1) {
        say("Error: --ssl-only requires SSL to be enabled");
        return 1;
    }

    if (::prepare_master($server_ref) == 0) {
        if (defined($server_ref->{"server_sock"})) { core::socket_close($server_ref->{"server_sock"}); }
        return 1;
    }

    # Install signal handlers for graceful shutdown (before spawning workers)
    ::install_signal_handlers($server_ref);

    # Set master process title
    core::setproctitle("cannoli [master]");

    say("Starting " . $server_ref->{"num_workers"} . " worker processes...");

    # Spawn workers (and the ticker, if a library wants one)
    ::spawn_workers($server_ref);
    ::spawn_tickers($server_ref);

    # Run master loop
    ::master_loop($server_ref);

    return 0;
}

# Run the server in single-process mode (for development)
func Cannoli_Server_run_single(scalar $server_ref) int {
    $server_ref->{"single_process"} = 1;

    # Create HTTP listening socket (unless ssl_only mode)
    my scalar $server_sock = undef;
    my int $http_fd = -1;
    if ($server_ref->{"ssl_only"} != 1) {
        $server_sock = ::create_socket($server_ref);
        if (!defined($server_sock)) {
            return 1;
        }
        $http_fd = core::socket_fd($server_sock);
    }

    # Create SSL listening socket if SSL is enabled
    my scalar $ssl_server = undef;
    my int $ssl_fd = -1;
    if ($server_ref->{"ssl_requested"} == 1) {
        if ($server_ref->{"ssl_enabled"} != 1) {
            say("Error: SSL was requested but SSL library could not be loaded");
            if (defined($server_sock)) { core::socket_close($server_sock); }
            return 1;
        }
        $ssl_server = ::create_ssl_socket($server_ref);
        if (!defined($ssl_server)) {
            if (defined($server_sock)) { core::socket_close($server_sock); }
            return 1;
        }
        my scalar $ssl_fd_fn = $server_ref->{"ssl_fd_fn"};
        $ssl_fd = core::dl_call_int_sv($ssl_fd_fn, [$ssl_server]);
    } elsif ($server_ref->{"ssl_only"} == 1) {
        say("Error: --ssl-only requires SSL to be enabled");
        return 1;
    }

    if (::prepare_master($server_ref) == 0) {
        if (defined($server_sock)) { core::socket_close($server_sock); }
        return 1;
    }

    # Install signal handlers for graceful shutdown
    ::install_signal_handlers($server_ref);
    ::init_worker_stats();

    say("Running in single-process development mode");
    say("Press Ctrl+C to stop");

    $server_ref->{"running"} = 1;

    while ($server_ref->{"running"} == 1) {
        # Build array of file descriptors to monitor
        my array @fds = ();
        if ($http_fd >= 0) {
            push(\@fds, $http_fd);
        }
        if ($ssl_fd >= 0) {
            push(\@fds, $ssl_fd);
        }

        # Wait for connections on either socket
        my array @ready = core::select_fds(\@fds, 1000);
        my int $num_ready = scalar(@ready);
        my int $i = 0;

        while ($i < $num_ready) {
            my int $ready_fd = $ready[$i];

            if ($ready_fd == $http_fd) {
                # HTTP connection
                my scalar $client = core::socket_accept($server_sock);
                if (defined($client)) {
                    my scalar $pc = ::plain_conn($client);
                    try {
                        ::handle_connection($server_ref, $pc);
                    } catch ($conn_err) {
                        Cannoli::Log::error("connection from " . $pc->{"peer"} . " failed: " . $conn_err);
                        ::conn_close($server_ref, $pc);
                    }
                }
            } elsif ($ready_fd == $ssl_fd) {
                # HTTPS connection
                my scalar $tls = ::accept_tls($server_ref, $ssl_server);
                if (defined($tls)) {
                    try {
                        ::handle_connection($server_ref, $tls);
                    } catch ($tls_err) {
                        Cannoli::Log::error("TLS connection from " . $tls->{"peer"} . " failed: " . $tls_err);
                        ::conn_close($server_ref, $tls);
                    }
                }
            }

            $i = $i + 1;
        }
    }

    core::socket_close($server_sock);
    if (defined($ssl_server)) {
        my scalar $ssl_close_fn = $server_ref->{"ssl_close_fn"};
        core::dl_call_void_sv($ssl_close_fn, [$ssl_server]);
    }
    return 0;
}
