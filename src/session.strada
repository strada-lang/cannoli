package Cannoli::Session;


# cannoli/src/session.strada - Session management
#
# File-based session storage with cookie tracking.
# Sessions are stored in /tmp/cannoli_sessions/ directory.
#
# Usage:
#   my scalar $session = Cannoli::Session::new();
#   Cannoli::Session::set($session, "user_id", "42");
#   Cannoli::Session::save($session);
#
#   my scalar $loaded = Cannoli::Session::load($session_id);
#   my str $user = Cannoli::Session::get($loaded, "user_id");

# Session directory
my str $g_session_dir = "/tmp/cannoli_sessions";
my str $g_session_cookie = "cannoli_session";
my int $g_session_ttl = 3600;  # 1 hour default TTL

my int $g_session_dir_ok = 0;

__C__ {
#include <sys/stat.h>
#include <unistd.h>
/* 1 if path is a real directory (not a symlink) owned by us with no
 * group/other access -- creating it 0700 when missing; 0 otherwise. A
 * directory in /tmp that another local user created first (or a symlink they
 * planted) would let them read or forge sessions. */
static int cannoli_private_dir(const char *path) {
    struct stat st;
    if (lstat(path, &st) != 0) {
        if (mkdir(path, 0700) != 0) return 0;
        if (lstat(path, &st) != 0) return 0;
    }
    if (!S_ISDIR(st.st_mode) || st.st_uid != geteuid()) return 0;
    if ((st.st_mode & 077) != 0 && chmod(path, 0700) != 0) return 0;
    return 1;
}
}

func Cannoli_Session_private_dir(str $path) int {
    my scalar $ok = 0;
    __C__ {
        char *p = strada_to_str(path);
        ok = strada_new_int(p ? cannoli_private_dir(p) : 0);
        free(p);
    }
    return $ok;
}

# Initialize session system: make sure the directory is ours alone. If the
# configured one is not (e.g. pre-created by another user), fall back to a
# per-user directory; if that fails too, sessions are not stored at all.
func Cannoli_Session_init() void {
    if ($g_session_dir_ok == 1) { return; }
    if (::private_dir($g_session_dir) == 1) {
        $g_session_dir_ok = 1;
        return;
    }
    my str $fallback = $g_session_dir . "-" . core::geteuid();
    if (::private_dir($fallback) == 1) {
        Cannoli::Log::warn("session directory " . $g_session_dir . " is not a private directory owned by this user; using " . $fallback);
        $g_session_dir = $fallback;
        $g_session_dir_ok = 1;
        return;
    }
    Cannoli::Log::error("no usable private session directory (" . $g_session_dir . "); sessions are disabled");
    $g_session_dir_ok = -1;
}

# Configure session settings
func Cannoli_Session_configure(str $dir, str $cookie_name, int $ttl) void {
    if (length($dir) > 0) {
        $g_session_dir = $dir;
        $g_session_dir_ok = 0;
    }
    if (length($cookie_name) > 0) {
        $g_session_cookie = $cookie_name;
    }
    if ($ttl > 0) {
        $g_session_ttl = $ttl;
    }
    ::init();
}

# Generate a secure session ID (32 hex characters)
func Cannoli_Session_generate_id() str {
    my str $id = core::random_bytes_hex(16);
    if (::is_valid_id($id) == 1) {
        return $id;
    }
    return "";
}

func Cannoli_Session_is_valid_id(str $id) int {
    if (length($id) != 32) { return 0; }

    my int $i = 0;
    while ($i < length($id)) {
        my str $ch = substr($id, $i, 1);
        my int $is_hex = 0;
        if ($ch ge "0" && $ch le "9") { $is_hex = 1; }
        if ($ch ge "a" && $ch le "f") { $is_hex = 1; }
        if ($ch ge "A" && $ch le "F") { $is_hex = 1; }
        if ($is_hex == 0) { return 0; }
        $i = $i + 1;
    }

    return 1;
}

# Get session file path
func Cannoli_Session_file_path(str $id) str {
    return $g_session_dir . "/sess_" . $id;
}

# Create a new session
func Cannoli_Session_new() scalar {
    ::init();

    my hash %session = ();
    $session{"id"} = ::generate_id();
    $session{"created"} = core::time();
    $session{"modified"} = core::time();
    $session{"data"} = {};

    return \%session;
}

# Load a session by ID
func Cannoli_Session_load(str $id) scalar {
    if (::is_valid_id($id) == 0) {
        return undef;
    }
    ::init();
    if ($g_session_dir_ok != 1) { return undef; }

    my str $path = ::file_path($id);

    if (core::is_file($path) == 0) {
        return undef;
    }

    # Read and parse session file
    my str $content = slurp($path);
    if (length($content) == 0) {
        return undef;
    }

    # Parse session data (simple key=value format)
    my hash %session = ();
    $session{"id"} = $id;
    $session{"data"} = {};

    my array @lines = split("\n", $content);
    my int $i = 0;
    my int $in_data = 0;

    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];

        if (length($line) == 0) {
            $i = $i + 1;
            next;
        }

        # Parse key=value
        my int $eq_pos = index($line, "=");
        if ($eq_pos > 0) {
            my str $key = substr($line, 0, $eq_pos);
            my str $value = substr($line, $eq_pos + 1, length($line) - $eq_pos - 1);

            if ($key eq "_created") {
                $session{"created"} = $value + 0;
            } elsif ($key eq "_modified") {
                $session{"modified"} = $value + 0;
            } else {
                # User data
                my scalar $data = $session{"data"};
                my str $decoded_key = ::decode_value($key);
                $data->{$decoded_key} = ::decode_value($value);
            }
        }

        $i = $i + 1;
    }

    # Check TTL
    my int $now = core::time();
    my int $modified = $session{"modified"} + 0;
    if ($now - $modified > $g_session_ttl) {
        # Session expired
        ::destroy($id);
        return undef;
    }

    return \%session;
}

# Save a session to file
func Cannoli_Session_save(scalar $session) int {
    ::init();
    if ($g_session_dir_ok != 1) { return 0; }

    my str $id = $session->{"id"};
    if (::is_valid_id($id) == 0) {
        return 0;
    }
    my str $path = ::file_path($id);

    # Update modified time
    $session->{"modified"} = core::time();

    # Build file content
    my str $content = "";
    $content = $content . "_created=" . $session->{"created"} . "\n";
    $content = $content . "_modified=" . $session->{"modified"} . "\n";

    # Save data fields
    my scalar $data = $session->{"data"};
    my array @keys = keys(%{$data});
    my int $i = 0;

    while ($i < scalar(@keys)) {
        my str $key = $keys[$i];
        my scalar $raw_val = $data->{$key};
        if (defined($raw_val) && $key ne "_created" && $key ne "_modified") {
            my str $enc_key = ::encode_value($key);
            my str $value = ::encode_value($raw_val);
            $content = $content . $enc_key . "=" . $value . "\n";
        }
        $i = $i + 1;
    }

    # Write atomically via temporary file with 0600 permissions
    my str $tmp_path = $path . ".tmp." . core::getpid();
    spew($tmp_path, $content);
    core::chmod($tmp_path, 384);  # 0600
    core::rename($tmp_path, $path);
    return 1;
}

# Give a session a new ID (data kept), removing the stored copy under the
# old one. Defends against session fixation when called at login.
func Cannoli_Session_regenerate(scalar $session) void {
    my str $old = $session->{"id"};
    $session->{"id"} = ::generate_id();
    if (length($old) > 0 && ::is_valid_id($old) == 1) {
        ::destroy($old);
    }
    ::save($session);
}

# Destroy a session
func Cannoli_Session_destroy(str $id) void {
    if (::is_valid_id($id) == 0) {
        return;
    }
    my str $path = ::file_path($id);
    if (core::is_file($path) == 1) {
        core::unlink($path);
    }
}

# Get a value from session
func Cannoli_Session_get(scalar $session, str $key) scalar {
    my scalar $data = $session->{"data"};
    if (exists(%{$data}, $key)) {
        return $data->{$key};
    }
    return undef;
}

# Set a value in session
func Cannoli_Session_set(scalar $session, str $key, scalar $value) void {
    my scalar $data = $session->{"data"};
    $data->{$key} = $value;
}

# Delete a value from session
func Cannoli_Session_delete(scalar $session, str $key) void {
    my scalar $data = $session->{"data"};
    if (exists(%{$data}, $key)) {
        delete($data->{$key});
    }
}

# Check if session has a key
func Cannoli_Session_has(scalar $session, str $key) int {
    my scalar $data = $session->{"data"};
    if (exists(%{$data}, $key) && defined($data->{$key})) {
        return 1;
    }
    return 0;
}

# Get session ID
func Cannoli_Session_id(scalar $session) str {
    return $session->{"id"};
}

# Get cookie name
func Cannoli_Session_cookie_name() str {
    return $g_session_cookie;
}

# Get TTL
func Cannoli_Session_ttl() int {
    return $g_session_ttl;
}

# Encode a value for storage (escape newlines and equals)
func Cannoli_Session_encode_value(scalar $value) str {
    if (!defined($value)) {
        return "";
    }

    my str $s = "" . $value;

    # Escape special chars: \ -> \\, newline -> \n, = -> \e
    my str $result = "";
    my int $i = 0;
    my int $len = length($s);

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($ch eq "\\") {
            $result = $result . "\\\\";
        } elsif ($ch eq "\n") {
            $result = $result . "\\n";
        } elsif ($ch eq "\r") {
            $result = $result . "\\r";
        } elsif ($ch eq "=") {
            $result = $result . "\\e";
        } else {
            $result = $result . $ch;
        }

        $i = $i + 1;
    }

    return $result;
}

# Decode a stored value
func Cannoli_Session_decode_value(str $s) str {
    my str $result = "";
    my int $i = 0;
    my int $len = length($s);

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($ch eq "\\" && $i + 1 < $len) {
            my str $next_ch = substr($s, $i + 1, 1);
            if ($next_ch eq "\\") {
                $result = $result . "\\";
                $i = $i + 2;
                next;
            } elsif ($next_ch eq "n") {
                $result = $result . "\n";
                $i = $i + 2;
                next;
            } elsif ($next_ch eq "r") {
                $result = $result . "\r";
                $i = $i + 2;
                next;
            } elsif ($next_ch eq "e") {
                $result = $result . "=";
                $i = $i + 2;
                next;
            }
        }

        $result = $result . $ch;
        $i = $i + 1;
    }

    return $result;
}

# Clean up expired sessions (call periodically)
func Cannoli_Session_cleanup() int {
    if (core::is_dir($g_session_dir) == 0) {
        return 0;
    }

    my int $now = core::time();
    my int $cleaned = 0;

    my array @files = core::readdir($g_session_dir);
    my int $i = 0;

    while ($i < scalar(@files)) {
        my str $file = $files[$i];

        # Only process session files
        if (substr($file, 0, 5) eq "sess_") {
            my str $path = $g_session_dir . "/" . $file;

            # Check modification time via file content
            my str $content = slurp($path);
            my int $modified = 0;

            # Find _modified= line
            my int $pos = index($content, "_modified=");
            if ($pos >= 0) {
                my str $rest = substr($content, $pos + 10, 20);
                my int $nl = index($rest, "\n");
                if ($nl > 0) {
                    my str $ts = substr($rest, 0, $nl);
                    $modified = $ts + 0;
                }
            }

            # Remove if expired
            if ($modified > 0 && $now - $modified > $g_session_ttl) {
                core::unlink($path);
                $cleaned = $cleaned + 1;
            }
        }

        $i = $i + 1;
    }

    return $cleaned;
}
