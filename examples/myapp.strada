# myapp.strada - an example Cannoli handler library
#
# A library exports cannoli_dispatch($c). It builds the response on the
# Cannoli object and returns $c->done(), or "" to leave the request to the
# next library, the router, or the 404 page.
#
# Build and run (from the cannoli directory):
#   strada --shared examples/myapp.strada -o examples/myapp.so
#   ./cannoli --library ./examples/myapp.so --dev -p 8080
#   ./cannoli -c examples/myapp.conf                  # the same, from a config file
#   ./cannoli -c examples/multi_lib.conf              # mounted under /app (path_info)
#
# NOTE: no main() function - this is a library only

my str $g_greeting = "Hello";

# Optional: called once at startup with the text after "myapp.so:" in the
# library spec (./cannoli -l "./examples/myapp.so:greeting=Ciao").
# Returning 0 stops the server from starting.
func cannoli_init(str $config) int {
    foreach my str $part (split(";", $config)) {
        if (length($part) > 9 && substr($part, 0, 9) eq "greeting=") {
            $g_greeting = substr($part, 9, length($part) - 9);
        }
    }
    return 1;
}

func cannoli_dispatch(scalar $c) str {
    # Mounted under a prefix ("[library] /app = myapp.so"), path_info is the
    # part after the prefix; loaded with --library it is empty.
    my str $path = $c->path_info();
    if (length($path) == 0) { $path = $c->path(); }

    # GET / - an HTML page
    if ($c->is_get() && $path eq "/") {
        $c->render_html("<!DOCTYPE html>\n<html><head><title>My Strada App</title></head>\n<body>\n"
            . "<h1>" . $c->html_escape($g_greeting) . " from a Strada library</h1>\n<ul>\n"
            . "<li><a href=\"hello?name=World\">hello?name=World</a> - text</li>\n"
            . "<li><a href=\"api/status\">api/status</a> - JSON</li>\n"
            . "<li><a href=\"user/42\">user/42</a> - a path parameter</li>\n"
            . "<li><a href=\"old-page\">old-page</a> - a redirect</li>\n"
            . "<li><a href=\"stream\">stream</a> - a chunked response</li>\n"
            . "</ul>\n<p>POST api/echo echoes a JSON body.</p>\n</body></html>\n");
        return $c->done();
    }

    # GET /hello?name=... - plain text. User input is only ever a body here:
    # render_text() never lets it choose the status, headers or content type.
    if ($c->is_get() && $path eq "/hello") {
        my str $name = $c->param("name");
        $c->render_text($g_greeting . ", " . (length($name) > 0 ? $name : "stranger") . "!\n");
        return $c->done();
    }

    # GET /api/status - JSON from a data structure
    if ($c->is_get() && $path eq "/api/status") {
        $c->set_header("Cache-Control", "no-store");
        $c->render_json({"status" => "ok", "language" => "Strada", "request_id" => $c->request_id()});
        return $c->done();
    }

    # GET /user/{id}
    if ($c->is_get() && $path =~ /^\/user\/([0-9]+)$/) {
        my str $id = substr($path, 6, length($path) - 6);
        $c->render_json({"user_id" => $id, "name" => "User " . $id});
        return $c->done();
    }

    # POST /api/echo - status, cookie and JSON body
    if ($c->is_post() && $path eq "/api/echo") {
        $c->status(201);
        $c->set_cookie("last_echo", "" . core::time(), "/", 3600);
        $c->render_json({"received" => core::byte_length($c->body()), "json" => $c->json_body()});
        return $c->done();
    }

    # GET /old-page - redirect
    if ($path eq "/old-page") {
        $c->redirect("hello?name=redirected", 0);
        return $c->done();
    }

    # GET /stream - a response sent in pieces
    if ($c->is_get() && $path eq "/stream") {
        $c->content_type("text/plain");
        $c->start_chunked();
        my int $i = 1;
        while ($i <= 5) {
            if ($c->write_chunk("line " . $i . "\n") < 0) { last; }   # client went away
            $i = $i + 1;
        }
        $c->end_chunked();
        return $c->done();
    }

    return "";   # not ours: next library, router, or 404
}
