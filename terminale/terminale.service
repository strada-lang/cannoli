# systemd user unit for Terminale: your web terminal, started at login (or
# at boot with `loginctl enable-linger $USER`).
#
#   mkdir -p ~/.config/systemd/user
#   cp terminale.service ~/.config/systemd/user/
#   # edit the two paths below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now terminale
#
# Terminals are separate processes: `systemctl --user restart terminale`
# (KillMode=process) leaves them running, and they are back after sign-in.

[Unit]
Description=Terminale web terminal
After=network.target

[Service]
ExecStart=%h/cannoli/terminale/start.sh -c %h/.config/terminale.conf -p 7681
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
