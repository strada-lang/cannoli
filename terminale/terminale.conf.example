# Terminale configuration. Copy to terminale.conf (keep it private:
# chmod 600) and start with:  ./start.sh -c terminale.conf
#
# The terminals run as the user that starts Cannoli -- whoever can sign in
# here has that user's shell.

# Login (required)
user = admin

# Either a plain password ...
# password = change-me
# ... or, better, a crypt(3) hash. Generate one with:
#   openssl passwd -6
password_hash = $6$replace$with-the-output-of-openssl-passwd

# Two-factor sign-in: also ask for a 6-digit code from an authenticator app.
# Run ./totp-setup.sh terminale.conf to generate the secret.
# totp_secret = JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# How long a sign-in lasts, in seconds (default: 7 days)
# login_ttl = 604800

# Shell to run (default: your login shell)
# shell = /bin/bash

# Limit on simultaneously running terminals (default 32)
# max_sessions = 32

# End terminals nobody has been attached to for this many seconds
# (default 0: they run until closed or the shell exits)
# idle_timeout = 0

# Largest file the Files panel may download, in bytes (default 256MB)
# max_download = 268435456

# Where sign-ins and session sockets are kept (default ~/.terminale)
# dir = /home/me/.terminale
