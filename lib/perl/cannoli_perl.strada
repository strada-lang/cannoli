# cannoli_perl.strada - Perl dispatch library for Cannoli
#
# Runs Perl handlers inside Cannoli. The handler receives a Cannoli object
# (lib/perl/Cannoli.pm) with the request and builds the response on it.
#
# Usage:
#   cannoli --library ./cannoli_perl.so:script=/path/to/app.pl;handler=MyApp::handle
#
# Options (semicolon-separated):
#   handler=Sub::Name   - Perl sub called for each request (required)
#   script=/path/to.pl  - Perl script to load at startup
#   lib=/path/to/lib    - add to @INC (may be repeated)
#   use=Module::Name    - module to load at startup (may be repeated)
#   cannoli_pm=/path    - Cannoli.pm to use (default: the one next to this
#                         library, then /usr/local/lib/cannoli, then @INC)
#
# The interpreter is embedded by perl_bridge.c, which is linked into this
# library: there is one file to load and nothing to find at run time.

__C__ {
#include "perl_bridge.h"

/* The bytes of a Strada string, binary-safe (no copy). */
static pb_str cp_bytes(StradaValue *sv) {
    pb_str s = { "", 0 };
    if (sv && !STRADA_IS_TAGGED_INT(sv) && sv->type == STRADA_STR && sv->value.pv) {
        s.p = sv->value.pv;
        s.n = STRADA_STR_BYTELEN(sv);
        if (s.n == 0 && sv->value.pv[0] != 0) s.n = strlen(sv->value.pv);
    }
    return s;
}
}

my str $g_handler_sub = "";
my int $g_ready = 0;

# Value of the first "key=value" in a "k=v;k=v" option string ("" if absent)
func config_get(str $config, str $key) str {
    my array @all = config_get_all($config, $key);
    if (scalar(@all) > 0) { return $all[0]; }
    return "";
}

# Every value of $key (options such as lib= may be repeated)
func config_get_all(str $config, str $key) array {
    my array @values = ();
    my int $key_len = length($key);
    foreach my str $part (split(";", $config)) {
        my int $start = 0;
        while ($start < length($part) && (substr($part, $start, 1) eq " " || substr($part, $start, 1) eq "\t")) {
            $start = $start + 1;
        }
        if (length($part) > $start + $key_len && substr($part, $start, $key_len) eq $key
            && substr($part, $start + $key_len, 1) eq "=") {
            push(@values, substr($part, $start + $key_len + 1, length($part) - $start - $key_len - 1));
        }
    }
    return @values;
}

# One bridge call that takes a path or a name: 1 on success.
func bridge(str $what, str $arg) int {
    my scalar $ok = 0;
    __C__ {
        char *w = strada_to_str(what);
        char *a = strada_to_str(arg);
        int r = 0;
        if (w && a) {
            if (strcmp(w, "init") == 0) r = pb_init();
            else if (strcmp(w, "inc") == 0) r = pb_add_inc(a);
            else if (strcmp(w, "cannoli") == 0) r = pb_load_cannoli(*a ? a : NULL);
            else if (strcmp(w, "use") == 0) r = pb_use(a);
            else if (strcmp(w, "do") == 0) r = pb_do(a);
            else if (strcmp(w, "handler") == 0) r = pb_set_handler(a);
        }
        free(w);
        free(a);
        ok = strada_new_int(r);
    }
    return $ok;
}

func bridge_error() str {
    my scalar $msg = "";
    __C__ {
        msg = strada_new_str(pb_last_error());
    }
    return "" . $msg;
}

# Directory this library was loaded from
func self_dir() str {
    my scalar $dir = "";
    __C__ {
        dir = strada_new_str(pb_self_dir());
    }
    return "" . $dir;
}

func find_cannoli_pm(str $config) str {
    my str $given = config_get($config, "cannoli_pm");
    if (length($given) > 0) { return $given; }
    my str $dir = self_dir();
    if (length($dir) > 0 && core::is_file($dir . "/Cannoli.pm")) {
        return $dir . "/Cannoli.pm";
    }
    if (core::is_file("/usr/local/lib/cannoli/Cannoli.pm")) {
        return "/usr/local/lib/cannoli/Cannoli.pm";
    }
    return "";   # from @INC
}

func fail(str $what) int {
    my str $detail = bridge_error();
    say("cannoli_perl: ERROR - " . $what . (length($detail) > 0 ? ": " . $detail : ""));
    return 0;
}

# Initialize the Perl library. Called once at startup, in the master: the
# script is compiled once and every worker shares the result.
func cannoli_init(str $config) int {
    $g_ready = 0;
    $g_handler_sub = config_get($config, "handler");
    if (length($g_handler_sub) == 0) {
        say("cannoli_perl: ERROR - missing required 'handler' option");
        say("Usage: --library ./cannoli_perl.so:script=app.pl;handler=MyApp::handle");
        return 0;
    }

    if (bridge("init", "") == 0) { return fail("could not start Perl"); }

    foreach my str $lib_path (config_get_all($config, "lib")) {
        bridge("inc", $lib_path);
    }
    if (bridge("cannoli", find_cannoli_pm($config)) == 0) { return fail("Cannoli.pm"); }

    foreach my str $module (config_get_all($config, "use")) {
        if (bridge("use", $module) == 0) { return fail("use " . $module); }
    }
    my str $script = config_get($config, "script");
    if (length($script) > 0) {
        if (bridge("do", $script) == 0) { return fail($script); }
    }
    if (bridge("handler", $g_handler_sub) == 0) { return fail("handler"); }

    $g_ready = 1;
    return 1;
}

# Dispatch one request to the Perl handler.
#
# The handler's response comes back as one framed string built by
# Cannoli.pm and is handed to Cannoli as such; a handler that set nothing
# declines the request (the next library, or a 404). A handler that dies
# becomes a plain 500: the error text goes to the log, not to the client.
func cannoli_dispatch(scalar $c) str {
    if ($g_ready != 1) {
        return "";
    }

    my str $method = "" . $c->{"_method"};
    my str $path = "" . $c->{"_path"};
    my str $path_info = defined($c->{"_path_info"}) ? ("" . $c->{"_path_info"}) : "";
    my str $query_string = defined($c->{"_query_string"}) ? ("" . $c->{"_query_string"}) : "";
    my str $body = defined($c->{"_body"}) ? ("" . $c->{"_body"}) : "";
    my str $remote_addr = defined($c->{"_remote_addr"}) ? ("" . $c->{"_remote_addr"}) : "";
    my str $content_type = defined($c->{"_content_type"}) ? ("" . $c->{"_content_type"}) : "";
    my str $scheme = defined($c->{"_scheme"}) ? ("" . $c->{"_scheme"}) : "http";
    my str $request_id = defined($c->{"_request_id"}) ? ("" . $c->{"_request_id"}) : "";
    my str $handler = $g_handler_sub;

    my str $headers = "";
    my scalar $hdrs = $c->{"_headers"};
    if (defined($hdrs)) {
        foreach my str $hn (keys(%{$hdrs})) {
            $headers = $headers . $hn . ": " . $hdrs->{$hn} . "\r\n";
        }
    }

    my scalar $out = "";
    my scalar $failed = 0;
    __C__ {
        pb_request rq;
        rq.method = cp_bytes(method);
        rq.path = cp_bytes(path);
        rq.path_info = cp_bytes(path_info);
        rq.query_string = cp_bytes(query_string);
        rq.body = cp_bytes(body);
        rq.headers = cp_bytes(headers);
        rq.remote_addr = cp_bytes(remote_addr);
        rq.content_type = cp_bytes(content_type);
        rq.scheme = cp_bytes(scheme);
        rq.request_id = cp_bytes(request_id);
        char *h = strada_to_str(handler);
        size_t n = 0;
        int bad = 0;
        char *res = pb_call(h, &rq, &n, &bad);
        free(h);
        strada_decref(out);
        out = strada_new_str_len(res ? res : "", res ? n : 0);
        free(res);
        failed = strada_new_int(bad);
    }

    if ($failed == 1) {
        throw "Perl handler " . $g_handler_sub . " died: " . $out;
    }
    if (core::byte_length($out) == 0) {
        return "";
    }
    return $c->framed_response("" . $out);
}
